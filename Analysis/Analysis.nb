       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "weakSiteFinalSummary", "]"}]}], "||", 
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "weakHoppingFinalSummary", "]"}]}]}],
           ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Load the two production summaries first.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"groups", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<WeakSite\>\"", ",", 
             RowBox[{"weakSiteFinalSummary", "[", "\"\<Cases\>\"", "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<WeakHopping\>\"", ",", 
             RowBox[{"weakHoppingFinalSummary", "[", "\"\<Cases\>\"", "]"}]}],
             "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"data", "=", 
              RowBox[{"LoadProductionData", "[", 
               RowBox[{"case", "[", "\"\<DataFile\>\"", "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"issues", ",", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<Case\>\"", "->", 
                    RowBox[{"case", "[", "\"\<Case\>\"", "]"}]}], ",", 
                    RowBox[{
                    "\"\<Issue\>\"", "->", 
                    "\"\<Cannot read data file\>\""}]}], "|>"}]}], "]"}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"raw", "=", 
              RowBox[{"Lookup", "[", 
               RowBox[{"data", ",", "\"\<RawResults\>\"", ",", "$Failed"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"applyCut", "=", 
              RowBox[{"Lookup", "[", 
               RowBox[{"data", ",", "\"\<ApplyRowCut\>\"", ",", "True"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"ListQ", "[", "raw", "]"}]}], "||", 
                RowBox[{"raw", "===", 
                 RowBox[{"{", "}"}]}]}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"issues", ",", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<Case\>\"", "->", 
                    RowBox[{"case", "[", "\"\<Case\>\"", "]"}]}], ",", 
                    RowBox[{
                    "\"\<Issue\>\"", "->", 
                    "\"\<No usable raw results\>\""}]}], "|>"}]}], "]"}], ";",
                 "\[IndentingNewLine]", 
                RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
                RowBox[{"Apply", " ", "the", " ", "mass"}], "-", 
                RowBox[{"plot", " ", "selection"}]}], ",", 
               RowBox[{"then", " ", "require", " ", "valid", " ", 
                RowBox[{"angles", "."}]}]}], "*)"}], 
             RowBox[{"selected", "=", 
              RowBox[{"Select", "[", 
               RowBox[{"raw", ",", 
                RowBox[{"Function", "[", 
                 RowBox[{"r", ",", 
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"AssociationQ", "[", "r", "]"}]}], ",", 
                    RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"Lookup", "[", 
