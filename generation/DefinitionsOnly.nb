               RowBox[{"\"\<Parameters\>\"", "->", "bestParameters"}], ",", 
               RowBox[{"\"\<BatchSize\>\"", "->", "100"}], ",", 
               RowBox[{"\"\<BatchCount\>\"", "->", 
                RowBox[{"NFValidationSamples", "/", "100"}]}], ",", 
               RowBox[{"\"\<ApplyRowCut\>\"", "->", "True"}], ",", 
               RowBox[{"\"\<TrainingSeeds\>\"", "->", "NFTrainingSeeds"}], 
               ",", 
               RowBox[{"\"\<ValidationSeeds\>\"", "->", "NFValidationSeeds"}],
                ",", 
               RowBox[{"\"\<TargetAnglesDegrees\>\"", "->", "NFTarget"}], ",", 
               RowBox[{"\"\<AngleBoundsDegrees\>\"", "->", "NFBounds"}], ",", 
               
               RowBox[{"\"\<RawResults\>\"", "->", "raw"}]}], "|>"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"valid", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"raw", ",", "NFValid"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"validFraction", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Length", "[", "valid", "]"}], "/", 
             RowBox[{"Length", "[", "raw", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"angles", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"valid", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"{", "}"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"valid", ",", "\"\<AnglesDegrees\>\""}], "]"}], 
              "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"medians", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"angles", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"Missing", "[", "\"\<NoValidSamples\>\"", "]"}], ",", 
             RowBox[{"Median", "/@", 
              RowBox[{"Transpose", "[", "angles", "]"}]}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Denominator", " ", "includes", " ", "ALL", " ", "attempted", " ", 
            "validation", " ", 
            RowBox[{"samples", ".", "Failed"}], " ", "or", " ", "rejected", 
            " ", "samples", " ", "do", " ", "not", " ", "disappear", " ", 
            "from", " ", "this", " ", 
            RowBox[{"fraction", "."}]}], "*)"}], 
          RowBox[{"fractionInside", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{
               RowBox[{"NFInBox", "/@", "angles"}], ",", "True"}], "]"}], "/", 
             RowBox[{"Length", "[", "raw", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"precisionCheck", "=", 
           RowBox[{"TheorySpaceNeutrinos`TSPrecisionCheck", "[", 
            RowBox[{"bestParameters", ",", "20"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"NFSave", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"caseFolder", ",", "\"\<precision_check.wxf\>\""}], 
              "}"}], "]"}], ",", "precisionCheck"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"precisionOK", "=", 
           RowBox[{
            RowBox[{"AssociationQ", "[", "precisionCheck", "]"}], "&&", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"precisionCheck", ",", "\"\<Pass\>\"", ",", "False"}], 
              "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Operational", " ", "success", " ", 
             RowBox[{"criterion", ":", "\[IndentingNewLine]", 
              RowBox[{">=", 
               RowBox[{
                RowBox[{
                "90", "%", " ", "of", " ", "all", " ", "trials", " ", 
                 "inside", " ", "all", " ", "three", " ", "marginal", " ", 
                 "3"}], "-", 
                RowBox[{"sigma", " ", "ranges"}]}]}]}]}], ",", 
            RowBox[{
            "medians", " ", "within", " ", "the", " ", "chosen", " ", 
             "objective", " ", "scales"}], ",", 
            RowBox[{"precision", " ", "check", " ", 
             RowBox[{"passes", ".", "This"}], " ", "is", " ", "NOT", " ", "a",
              " ", "joint", " ", "experimental", " ", "confidence", " ", 
             RowBox[{"region", "."}]}]}], "*)"}], 
          RowBox[{"targetMet", "=", 
           RowBox[{
            RowBox[{"angles", "=!=", 
             RowBox[{"{", "}"}]}], "&&", 
            RowBox[{"fractionInside", ">=", "0.90"}], "&&", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"medians", "-", "NFTarget"}], ")"}], "/", 
                "NFScale"}], "]"}], "]"}], "<=", "1"}], "&&", 
            "precisionOK"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"row", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
             RowBox[{"\"\<Status\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
               "targetMet", ",", "\"\<Angle target met\>\"", ",", 
                "\"\<Needs more work\>\""}], "]"}]}], ",", 
             RowBox[{"\"\<MatrixKey\>\"", "->", 
              RowBox[{"NFKey", "[", "p", "]"}]}], ",", 
             RowBox[{"\"\<BestMatrix\>\"", "->", 
              RowBox[{"best", "[", "\"\<Matrix\>\"", "]"}]}], ",", 
             RowBox[{"\"\<Parameters\>\"", "->", "bestParameters"}], ",", 
             RowBox[{"\"\<TrainingScore\>\"", "->", 
              RowBox[{"best", "[", "\"\<Score\>\"", "]"}]}], ",", 
             RowBox[{"\"\<ValidationMedianDegrees\>\"", "->", "medians"}], 
             ",", 
             RowBox[{"\"\<ValidAngleFraction\>\"", "->", "validFraction"}], 
             ",", 
             RowBox[{
             "\"\<FractionAllTrialsInside3Sigma\>\"", "->", 
              "fractionInside"}], ",", 
             RowBox[{"\"\<PrecisionCheckPassed\>\"", "->", "precisionOK"}], 
             ",", 
             RowBox[{"\"\<SearchSeconds\>\"", "->", "searchSeconds"}], ",", 
             RowBox[{"\"\<CaseFolder\>\"", "->", "caseFolder"}], ",", 
             RowBox[{"\"\<DataFile\>\"", "->", "dataFile"}]}], "|>"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"NFSave", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"caseFolder", ",", "\"\<benchmark.wxf\>\""}], "}"}], 
             "]"}], ",", "row"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"caseName", ",", "\"\< | \>\"", ",", 
            RowBox[{"row", "[", "\"\<Status\>\"", "]"}], ",", 
            "\"\< | validation medians = \>\"", ",", "medians", ",", 
            "\"\< | fraction inside ranges = \>\"", ",", "fractionInside"}], 
           "]"}], ";", "\[IndentingNewLine]", "row"}]}], "]"}]}], "]"}]}], 
