    RowBox[{
    "Calculates", " ", "results", " ", "using", " ", "supplied", " ", 
     "blocks", " ", "without", " ", "generating", " ", "new", " ", "random", 
     " ", 
     RowBox[{"entries", "."}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
