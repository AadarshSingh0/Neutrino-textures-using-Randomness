Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"STRONG", "-", 
    RowBox[{
    "SITE", " ", "DIRAC", " ", "DATA", " ", "GENERATION", " ", "Three", " ", 
     "geometries", " ", "and", " ", "two", " ", "flavour"}], "-", 
    RowBox[{"mixing", " ", 
     RowBox[{"channels", ".", "Uses"}], " ", "the", " ", "numerical", " ", 
     "inputs", " ", "in", " ", 
     RowBox[{"fig15Parameters", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"autoSummary", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"base", "=", "fig15Parameters"}], ",", "mixingMatrix", ",", 
         RowBox[{"batchSize", "=", "100"}], ",", 
         RowBox[{"batchCount", "=", "100"}], ",", 
         RowBox[{"applyRowCut", "=", "True"}], ",", "cases", ",", "folder", 
         ",", 
         RowBox[{"summary", "=", 
          RowBox[{"{", "}"}]}], ",", "geometry", ",", "channel", ",", "p", 
         ",", "prefix", ",", "seconds", ",", "raw", ",", "dataFile", ",", 
         "summaryFile", ",", "row", ",", "scanOK", ",", "j"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"StringQ", "[", 
            RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Please save the notebook first.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mixingMatrix", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"2", "/", "5"}], ",", 
             RowBox[{"3", "/", "5"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"3", "/", "10"}], ",", "1", ",", 
             RowBox[{"4", "/", "5"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"9", "/", "10"}], ",", 
             RowBox[{"3", "/", "10"}], ",", "1"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cases", "=", 
         RowBox[{"Tuples", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "\"\<Local\>\"", ",", "\"\<Petersen\>\"", ",", 
              "\"\<NonLocal\>\""}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Boundary\>\"", ",", "\"\<Hamiltonian\>\""}], 
             "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"folder", "=", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], ",", 
             RowBox[{"\"\<PaperPlots_\>\"", "<>", 
              RowBox[{"DateString", "[", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
                 ",", "\"\<_\>\"", ",", "\"\<Hour\>\"", ",", "\"\<Minute\>\"",
                  ",", "\"\<Second\>\""}], "}"}], "]"}]}]}], "}"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Saving strong-site Dirac data in: \>\"", ",", "folder"}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"geometry", ",", "channel"}], "}"}], "=", 
            RowBox[{"cases", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"p", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"base", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Preset\>\"", "->", "\"\<StrongSite\>\""}], ",", 
                RowBox[{"\"\<Nature\>\"", "->", "\"\<Dirac\>\""}], ",", 
                RowBox[{"\"\<Geometry\>\"", "->", "geometry"}], ",", 
                RowBox[{"\"\<Channel\>\"", "->", "channel"}], ",", 
                RowBox[{"\"\<ActiveFlavor\>\"", "->", 
                 RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
                RowBox[{"\"\<HamiltonianFlavor\>\"", "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"channel", "===", "\"\<Hamiltonian\>\""}], ",", 
                   "mixingMatrix", ",", 
                   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}], ",", 
                
                RowBox[{"\"\<DiracRightFlavor\>\"", "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"channel", "===", "\"\<Boundary\>\""}], ",", 
                   "mixingMatrix", ",", 
                   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}]}], 
               "|>"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"prefix", "=", 
            RowBox[{"StringRiffle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ToLowerCase", "[", "geometry", "]"}], ",", 
                "\"\<site_strong\>\"", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"channel", "===", "\"\<Boundary\>\""}], ",", 
                  "\"\<yukawa\>\"", ",", "\"\<hamiltonian\>\""}], "]"}], ",", 
                "\"\<dirac\>\""}], "}"}], ",", "\"\<_\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<[\>\"", ",", "j", ",", "\"\</\>\"", ",", 
             RowBox[{"Length", "[", "cases", "]"}], ",", 
             "\"\<] Starting \>\"", ",", "prefix", ",", "\"\< | \>\"", ",", 
             RowBox[{"batchSize", " ", "batchCount"}], ",", 
             "\"\< trials\>\""}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"seconds", ",", "raw"}], "}"}], "=", 
            RowBox[{"AbsoluteTiming", "[", 
             RowBox[{"TSScan", "[", 
              RowBox[{"p", ",", 
               RowBox[{"batchSize", " ", "batchCount"}], ",", 
               RowBox[{"\"\<Parallel\>\"", "->", "True"}]}], "]"}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Save", " ", "every", " ", "result", " ", "before", " ", "any", 
             " ", "selection", " ", "or", " ", 
             RowBox[{"analysis", ".", "ApplyRowCut"}], " ", "records", " ", 
             "the", " ", "intended", " ", "downstream", " ", 
             RowBox[{"selection", "."}]}], "*)"}], 
           RowBox[{"dataFile", "=", 
            RowBox[{"Export", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"folder", ",", 
                 RowBox[{"prefix", "<>", "\"\<_data.wxf\>\""}]}], "}"}], 
               "]"}], ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
                RowBox[{"\"\<BatchSize\>\"", "->", "batchSize"}], ",", 
                RowBox[{"\"\<BatchCount\>\"", "->", "batchCount"}], ",", 
                RowBox[{"\"\<ApplyRowCut\>\"", "->", "applyRowCut"}], ",", 
                RowBox[{"\"\<Seconds\>\"", "->", "seconds"}], ",", 
                RowBox[{"\"\<RawResults\>\"", "->", "raw"}]}], "|>"}], ",", 
              "\"\<WXF\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"dataFile", "===", "$Failed"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Data saving failed. Stopping at \>\"", ",", "prefix"}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Return", "[", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Folder\>\"", "->", "folder"}], ",", 
                 RowBox[{"\"\<CompletedCases\>\"", "->", "summary"}], ",", 
                 RowBox[{"\"\<UnsavedParameters\>\"", "->", "p"}], ",", 
                 RowBox[{"\"\<UnsavedRawResults\>\"", "->", "raw"}]}], "|>"}],
                "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"scanOK", "=", 
            RowBox[{
             RowBox[{"ListQ", "[", "raw", "]"}], "&&", 
             RowBox[{
              RowBox[{"Length", "[", "raw", "]"}], "==", 
              RowBox[{"batchSize", " ", "batchCount"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"row", "=", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Case\>\"", "->", "prefix"}], ",", 
              RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
              RowBox[{"\"\<Seconds\>\"", "->", "seconds"}], ",", 
              RowBox[{"\"\<RecordCount\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"ListQ", "[", "raw", "]"}], ",", 
                 RowBox[{"Length", "[", "raw", "]"}], ",", "0"}], "]"}]}], 
              ",", 
              RowBox[{"\"\<Status\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                "scanOK", ",", "\"\<Data saved\>\"", ",", 
                 "\"\<Incomplete scan saved\>\""}], "]"}]}], ",", 
              RowBox[{"\"\<DataFile\>\"", "->", "dataFile"}]}], "|>"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"summary", ",", "row"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"summaryFile", "=", 
            RowBox[{"Export", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"folder", ",", "\"\<scan_summary.wxf\>\""}], "}"}], 
               "]"}], ",", "summary", ",", "\"\<WXF\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"summaryFile", "===", "$Failed"}], ",", 
             RowBox[{
              RowBox[{
              "Print", "[", 
               "\"\<Summary saving failed. Case data are saved.\>\"", "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"Return", "[", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Folder\>\"", "->", "folder"}], ",", 
                 RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}], 
               "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"row", "[", "\"\<Status\>\"", "]"}], ",", "\"\<: \>\"", 
             ",", "prefix", ",", "\"\< | \>\"", ",", 
             RowBox[{"Round", "[", "seconds", "]"}], ",", "\"\< seconds\>\"", 
             ",", "\"\< | records = \>\"", ",", 
             RowBox[{"row", "[", "\"\<RecordCount\>\"", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Clear", "[", "raw", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", "scanOK"}], ",", 
             RowBox[{
              RowBox[{
              "Print", "[", "\"\<Stopping after the incomplete scan.\>\"", 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Return", "[", 
               RowBox[{"<|", 
                RowBox[{
