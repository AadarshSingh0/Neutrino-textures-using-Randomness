                    "cfg", "[", "\"\<MaximumEffectiveMassRelativeError\>\"", 
                    "]"}]}], "]"}]}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{
                    "dReasons", ",", 
                    "\"\<Effective mass fails full-matrix check\>\""}], 
                    "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{
                    "high", "[", "\"\<MajoranaEffectiveMassRelativeError\>\"",
                     "]"}], "<=", 
                    RowBox[{
                    "cfg", "[", "\"\<MaximumEffectiveMassRelativeError\>\"", 
                    "]"}]}], "]"}]}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{
                    "mReasons", ",", 
                    "\"\<Effective mass fails full-matrix check\>\""}], 
                    "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Return", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{"meta", ",", "high", ",", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Status\>\"", "->", "\"\<OK\>\""}], ",", 
                    RowBox[{"\"\<HExact\>\"", "->", "hExact"}], ",", 
                    RowBox[{"\"\<PrecisionUsed\>\"", "->", "prec"}], ",", 
                    RowBox[{"\"\<NumericalCheckError\>\"", "->", "error"}], 
                    ",", 
                    RowBox[{"\"\<DiracApproximationOK\>\"", "->", 
                    RowBox[{"(", 
                    RowBox[{"dReasons", "===", 
                    RowBox[{"{", "}"}]}], ")"}]}], ",", 
                    RowBox[{"\"\<MajoranaApproximationOK\>\"", "->", 
                    RowBox[{"(", 
                    RowBox[{"mReasons", "===", 
                    RowBox[{"{", "}"}]}], ")"}]}], ",", 
                    RowBox[{"\"\<DiracFlags\>\"", "->", "dReasons"}], ",", 
                    RowBox[{"\"\<MajoranaFlags\>\"", "->", "mReasons"}]}], 
                    "|>"}]}], "]"}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"low", "=", "high"}], ";"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"best", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AssociationQ", "[", "high", "]"}], ",", "high", ",", 
               RowBox[{"<|", "|>"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Join", "[", 
             RowBox[{"meta", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Status\>\"", "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"Det", "[", "hExact", "]"}], "==", "0"}], "]"}], 
                   ",", "\"\<SingularTower\>\"", ",", 
                   "\"\<NumericallyUnresolved\>\""}], "]"}]}], ",", 
                RowBox[{"\"\<HExact\>\"", "->", "hExact"}], ",", 
                RowBox[{"\"\<PrecisionUsed\>\"", "->", "prec"}], ",", 
                RowBox[{"\"\<BestAttempt\>\"", "->", "best"}], ",", 
                RowBox[{
                "\"\<Note\>\"", "->", 
                 "\"\<Not included in numerical quantiles; retained here \
explicitly.\>\""}]}], "|>"}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Preserve", " ", "completed", " ", "samples", " ", "progressively", 
          " ", "in", " ", "a", " ", "named", " ", 
          RowBox[{"variable", "."}]}], "*)"}], 
        RowBox[{"towerDiagnosticSamples", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tag", "=", 
            RowBox[{
             RowBox[{"par", "[", "\"\<Preset\>\"", "]"}], "<>", "\"\</\>\"", "<>", 
             RowBox[{"par", "[", "\"\<Geometry\>\"", "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Running \>\"", ",", "tag", ",", "\"\< ...\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"seed", "=", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<Seed\>\"", "]"}], "+", "j", "-", 
                "1"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"result", "=", 
               RowBox[{"TimeConstrained", "[", 
                RowBox[{
                 RowBox[{"runSample", "[", 
                  RowBox[{"par", ",", "seed"}], "]"}], ",", 
                 RowBox[{"cfg", "[", "\"\<SecondsPerSample\>\"", "]"}], ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Case\>\"", "->", "tag"}], ",", 
                   RowBox[{"\"\<Regime\>\"", "->", 
                    RowBox[{"par", "[", "\"\<Preset\>\"", "]"}]}], ",", 
                   RowBox[{"\"\<Geometry\>\"", "->", 
                    RowBox[{"par", "[", "\"\<Geometry\>\"", "]"}]}], ",", 
                   RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
                   RowBox[{"\"\<Status\>\"", "->", "\"\<TimedOut\>\""}]}], 
                  "|>"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"towerDiagnosticSamples", ",", "result"}], "]"}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"cfg", "[", "\"\<SamplesPerCase\>\"", "]"}]}], "}"}]}],
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"tag", ",", "\"\< : \>\"", ",", 
             RowBox[{"Counts", "[", 
              RowBox[{"Lookup", "[", 
