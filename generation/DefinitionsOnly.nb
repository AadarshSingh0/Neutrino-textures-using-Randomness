Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"overnightFitSummary", "=", 
    RowBox[{"Catch", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"packagePath", ",", "loaded", ",", "cases", ",", "root", ",", 
          RowBox[{"summary", "=", 
           RowBox[{"{", "}"}]}], ",", "geometry", ",", "nature", ",", 
          "channel", ",", "p", ",", "row", ",", "j"}], "}"}], ",", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"StringQ", "[", 
             RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", "[", "\"\<Save the notebook before starting.\>\"", "]"}],
             ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"IntegerQ", "[", "NFValidationSamples", "]"}]}], "||", 
            RowBox[{"NFValidationSamples", "<=", "0"}], "||", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"NFValidationSamples", ",", "100"}], "]"}], "!=", 
             "0"}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", "[", 
             "\"\<NFValidationSamples must be a positive multiple of \
100.\>\"", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"DownValues", "[", "#", "]"}], "]"}], ">", "0"}], 
                "&"}], "/@", 
               RowBox[{"{", 
                RowBox[{
                "WeakSiteParameters", ",", "NFRunCase", ",", "NFSave"}], 
                "}"}]}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", "[", 
             "\"\<First evaluate the starting-parameter and angle-search \
definitions.\>\"", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"packagePath", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], ",", 
             "\"\<TheorySpaceNeutrinos.wl\>\""}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FileExistsQ", "[", "packagePath", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Package not found: \>\"", ",", "packagePath"}], 
             "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
           RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"path", "=", "packagePath"}], "}"}], ",", 
           RowBox[{"loaded", "=", 
            RowBox[{"ParallelEvaluate", "[", 
             RowBox[{
              RowBox[{"Get", "[", "path", "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{
                "DownValues", "[", "TheorySpaceNeutrinos`TSMass", "]"}], 
                "]"}], ">", "0"}]}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"loaded", "===", 
             RowBox[{"{", "}"}]}], "||", 
            RowBox[{"!", 
             RowBox[{"AllTrue", "[", 
              RowBox[{"loaded", ",", "TrueQ"}], "]"}]}]}], ",", 
           RowBox[{
            RowBox[{
            "Print", "[", 
             "\"\<Package loading failed on one or more workers.\>\"", "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{
          "NFKey", ",", "NFWithMatrix", ",", "NFValid", ",", "NFScore", ",", 
           "NFSafeMass", ",", "NFTarget", ",", "NFScale"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cases", "=", 
          RowBox[{"Tuples", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<Local\>\"", ",", "\"\<Petersen\>\"", ",", 
               "\"\<NonLocal\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Dirac\>\"", ",", "\"\<Majorana\>\""}], "}"}], ",", 
             
             RowBox[{"{", 
              RowBox[{"\"\<Boundary\>\"", ",", "\"\<Hamiltonian\>\""}], 
              "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"root", "=", 
          RowBox[{"CreateDirectory", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], ",", 
              RowBox[{"\"\<WeakSite_AngleSearch_\>\"", "<>", 
               RowBox[{"DateString", "[", 
                RowBox[{"{", 
                 RowBox[{
                 "\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
                  ",", "\"\<_\>\"", ",", "\"\<Hour\>\"", ",", 
                  "\"\<Minute\>\"", ",", "\"\<Second\>\""}], "}"}], "]"}]}]}],
              "}"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"NFSave", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"root", ",", "\"\<search_settings.wxf\>\""}], "}"}], 
            "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<TargetAnglesDegrees\>\"", "->", "NFTarget"}], ",", 
             RowBox[{"\"\<ObjectiveScalesDegrees\>\"", "->", "NFScale"}], ",", 
             RowBox[{"\"\<AngleBoundsDegrees\>\"", "->", "NFBounds"}], ",", 
             RowBox[{"\"\<TrainingSeeds\>\"", "->", "NFTrainingSeeds"}], ",", 
             
             RowBox[{"\"\<ValidationSeeds\>\"", "->", "NFValidationSeeds"}], 
             ",", 
             RowBox[{"\"\<SecondsPerCase\>\"", "->", "NFSecondsPerCase"}], 
             ",", 
             RowBox[{"\"\<AllowedEntryMagnitudes\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"NFMinEntry", ",", "NFMaxEntry"}], "}"}]}], ",", 
             RowBox[{
             "\"\<FitSource\>\"", "->", 
              "\"\<NuFIT 6.1 NO, IC23 without SK atmospheric data\>\""}], ",", 
             RowBox[{"\"\<MassesAndCPPhaseFitted\>\"", "->", "False"}]}], 
            "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Output folder: \>\"", ",", "root"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Cases: \>\"", ",", 
           RowBox[{"Length", "[", "cases", "]"}], ",", "\"\< | Workers: \>\"",
            ",", 
           RowBox[{"Length", "[", 
            RowBox[{"Kernels", "[", "]"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"geometry", ",", "nature", ",", "channel"}], "}"}], "=", 
             RowBox[{"cases", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"p", "=", 
             RowBox[{"WeakSiteParameters", "[", 
              RowBox[{"geometry", ",", "nature", ",", "channel"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Case \>\"", ",", "j", ",", "\"\</\>\"", ",", 
              RowBox[{"Length", "[", "cases", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"row", "=", 
             RowBox[{"NFRunCase", "[", 
              RowBox[{"p", ",", "root", ",", "j"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"summary", ",", "row"}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"NFSave", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"root", ",", "\"\<summary.wxf\>\""}], "}"}], "]"}], 
              ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
                RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}]}], "]"}],
             ";"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "cases", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
           RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}]}]}], "]"}], 
      ",", "\"\<NFDisk\>\""}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"AssociationQ", "[", "overnightFitSummary", "]"}], ",", 
