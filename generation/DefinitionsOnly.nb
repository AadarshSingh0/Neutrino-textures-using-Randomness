           RowBox[{
            RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
            RowBox[{"\"\<BatchSize\>\"", "->", "100"}], ",", 
            RowBox[{"\"\<BatchCount\>\"", "->", 
             RowBox[{
              RowBox[{"Length", "[", "MTValidationSeeds", "]"}], "/", 
              "100"}]}], ",", 
            RowBox[{"\"\<ApplyRowCut\>\"", "->", "True"}], ",", 
            RowBox[{"\"\<TrainingSeeds\>\"", "->", "MTTrainingSeeds"}], ",", 
            RowBox[{"\"\<ValidationSeeds\>\"", "->", "MTValidationSeeds"}], 
            ",", 
            RowBox[{"\"\<RawResults\>\"", "->", "raw"}]}], "|>"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"validation", "=", 
         RowBox[{"MTMeasure", "[", "raw", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"precision", "=", 
         RowBox[{"TheorySpaceNeutrinos`TSPrecisionCheck", "[", 
          RowBox[{"p", ",", "20"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NFSave", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"folder", ",", "\"\<precision_check.wxf\>\""}], "}"}], 
           "]"}], ",", "precision"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"precisionOK", "=", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "precision", "]"}], "&&", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"precision", ",", "\"\<Pass\>\"", ",", "False"}], "]"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Qualitative", " ", "benchmark", " ", 
           RowBox[{"criterion", ":", 
            RowBox[{
            "median", " ", "splittings", " ", "within", " ", "a", " ", 
             "factor", " ", "of", " ", "3", " ", "of", " ", "targets"}]}]}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{
          "median", " ", "angles", " ", "inside", " ", "the", " ", "chosen", 
           " ", "marginal", " ", "ranges"}], ";", "\[IndentingNewLine]", 
          RowBox[{
          "at", " ", "least", " ", "90", "%", " ", "valid", " ", "samples"}], 
          ";", 
          RowBox[{"precision", " ", "check", " ", 
           RowBox[{"passes", ".", "This"}], " ", "is", " ", "not", " ", "an", 
           " ", "experimental", " ", "acceptance", " ", 
           RowBox[{"test", "."}]}]}], "*)"}], 
        RowBox[{"ballpark", "=", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"validation", ",", "\"\<MedianSplittingsEV2\>\""}], "]"}], 
          "&&", 
          RowBox[{
           RowBox[{"validation", "[", "\"\<ValidFraction\>\"", "]"}], ">=", 
           "0.90"}], "&&", 
          RowBox[{"NFInBox", "[", 
           RowBox[{"validation", "[", "\"\<MedianAnglesDegrees\>\"", "]"}], 
           "]"}], "&&", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"validation", "[", "\"\<MedianSplittingsEV2\>\"", "]"}], 
             "/", "MTTargetSplittings"}], ",", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"1", "/", "3"}], "<=", "#", "<=", "3"}], "]"}], 
             "&"}]}], "]"}], "&&", "precisionOK"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"validation", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
             RowBox[{"\"\<Status\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
               "ballpark", ",", "\"\<Ballpark benchmark found\>\"", ",", 
                "\"\<Best candidate; inspect results\>\""}], "]"}]}], ",", 
             RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
             RowBox[{"\"\<Sites\>\"", "->", 
              RowBox[{"p", "[", "\"\<Sites\>\"", "]"}]}], ",", 
             RowBox[{"\"\<HoppingMean\>\"", "->", 
              RowBox[{"p", "[", "\"\<HoppingMean\>\"", "]"}]}], ",", 
             RowBox[{"\"\<DecayBase\>\"", "->", 
              RowBox[{"p", "[", "\"\<DecayBase\>\"", "]"}]}], ",", 
             RowBox[{"\"\<PrecisionCheckPassed\>\"", "->", "precisionOK"}], 
             ",", 
             RowBox[{"\"\<CaseFolder\>\"", "->", "folder"}]}], "|>"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"NFSave", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"folder", ",", "\"\<benchmark.wxf\>\""}], "}"}], "]"}], 
          ",", "result"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"caseName", ",", "\"\< | \>\"", ",", 
          RowBox[{"result", "[", "\"\<Status\>\"", "]"}], ",", 
          "\"\< | masses (eV): \>\"", ",", 
          RowBox[{"Lookup", "[", 
           RowBox[{"result", ",", "\"\<MedianMassesEV\>\"", ",", 
            RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], "]"}], 
          ",", "\"\< | angles: \>\"", ",", 
          RowBox[{"Lookup", "[", 
           RowBox[{"result", ",", "\"\<MedianAnglesDegrees\>\"", ",", 
            RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"-", "Run"}]}]}], " ", "all", " ", "12", " ", 
      RowBox[{
       RowBox[{"cases", "--"}], "--"}]}], "-"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"massTuningSummary", "=", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"root", ",", "packagePath", ",", "loaded", ",", 
           RowBox[{"summary", "=", 
            RowBox[{"{", "}"}]}], ",", "row"}], "}"}], ",", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"StringQ", "[", 
              RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"Print", "[", "\"\<Save the notebook first.\>\"", "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AssociationQ", "[", "overnightFitSummary", "]"}]}], ",", 
            RowBox[{
             RowBox[{
             "Print", "[", "\"\<Load overnightFitSummary first.\>\"", "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"packagePath", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"NotebookDirectory", "[", "]"}], ",", 
              "\"\<TheorySpaceNeutrinos.wl\>\""}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"FileExistsQ", "[", "packagePath", "]"}]}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Package not found: \>\"", ",", "packagePath"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
            RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"path", "=", "packagePath"}], "}"}], ",", 
            RowBox[{"loaded", "=", 
             RowBox[{"ParallelEvaluate", "[", 
              RowBox[{
               RowBox[{"Get", "[", "path", "]"}], ";", "\[IndentingNewLine]", 
               
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{
                 "DownValues", "[", "TheorySpaceNeutrinos`TSMass", "]"}], 
                 "]"}], ">", "0"}]}], "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"loaded", "===", 
              RowBox[{"{", "}"}]}], "||", 
             RowBox[{"!", 
              RowBox[{"AllTrue", "[", 
               RowBox[{"loaded", ",", "TrueQ"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{
             "Print", "[", "\"\<Package loading failed on a worker.\>\"", 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "NFValid", ",", "NFSafeMass", ",", "NFInBox", ",", "NFTarget", ",",
             "NFBounds", ",", "MTMeasure", ",", "MTEvaluate", ",", 
            "MTTrainingSeeds", ",", "MTTargetSplittings", ",", 
            "MTAngleScales"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"root", "=", 
           RowBox[{"CreateDirectory", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"NotebookDirectory", "[", "]"}], ",", 
               RowBox[{"\"\<WeakSite_MassTuning_\>\"", "<>", 
                RowBox[{"DateString", "[", 
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
                   ",", "\"\<_\>\"", ",", "\"\<Hour\>\"", ",", 
                   "\"\<Minute\>\"", ",", "\"\<Second\>\""}], "}"}], 
                 "]"}]}]}], "}"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"NFSave", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"root", ",", "\"\<search_settings.wxf\>\""}], "}"}], 
             "]"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Sites\>\"", "->", "MTSites"}], ",", 
              RowBox[{"\"\<HoppingsTeV\>\"", "->", "MTHoppings"}], ",", 
              RowBox[{"\"\<DecayBases\>\"", "->", "MTDecayBases"}], ",", 
              RowBox[{"\"\<TrainingSeeds\>\"", "->", "MTTrainingSeeds"}], ",", 
              RowBox[{"\"\<ValidationSeeds\>\"", "->", "MTValidationSeeds"}], 
              ",", 
              RowBox[{
              "\"\<TargetSplittingsEV2\>\"", "->", "MTTargetSplittings"}], 
              ",", 
              RowBox[{"\"\<TargetAnglesDegrees\>\"", "->", "NFTarget"}], ",", 
              
              RowBox[{
              "\"\<MajoranaPsiCouplingFollowsHopping\>\"", "->", "True"}], 
              ",", 
              RowBox[{"\"\<FlavourMatricesFixed\>\"", "->", "True"}]}], 
             "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Saving in: \>\"", ",", "root"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"row", "=", 
              RowBox[{"MTRunCase", "[", 
               RowBox[{"entry", ",", "root"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"summary", ",", "row"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"NFSave", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"root", ",", "\"\<summary.wxf\>\""}], "}"}], "]"}], 
               ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
                 RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}]}], 
              "]"}], ";"}], ",", 
            RowBox[{"{", 
             RowBox[{"entry", ",", 
              RowBox[{"overnightFitSummary", "[", "\"\<Cases\>\"", "]"}]}], 
             "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
            RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}]}]}], "]"}], 
       ",", "\"\<NFDisk\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"AssociationQ", "[", "massTuningSummary", "]"}], ",", 
     RowBox[{"Dataset", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"KeyTake", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Case\>\"", ",", "\"\<Status\>\"", ",", "\"\<Sites\>\"", ",", 
            "\"\<HoppingMean\>\"", ",", "\"\<DecayBase\>\"", ",", 
            "\"\<MedianMassesEV\>\"", ",", "\"\<MedianMassSumEV\>\"", ",", 
            "\"\<MedianSplittingsEV2\>\"", ",", "\"\<MedianAnglesDegrees\>\"",
             ",", "\"\<PrecisionCheckPassed\>\""}], "}"}]}], "]"}], "&"}], "/@", 
       RowBox[{"massTuningSummary", "[", "\"\<Cases\>\"", "]"}]}], "]"}], ",",
      "massTuningSummary"}], "]"}]}]}]], "Input",
