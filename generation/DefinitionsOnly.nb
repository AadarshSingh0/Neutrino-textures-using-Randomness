             RowBox[{"\"\<HoppingHalfWidth\>\"", "->", 
              RowBox[{"1", "/", "10"}]}]}], "|>"}]}]}], "|>"}]}]}], "|>"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"towerDiagnosticRun", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cfg", "=", "towerDiagnosticConfig"}], ",", "n", ",", "g", 
