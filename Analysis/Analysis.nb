Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "the", " ", "same", " ", "data", " ", "folder", " ", 
    "selected", " ", "for", " ", "the", " ", "weak", " ", 
    RowBox[{"regimes", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"StringQ", "[", "angleDataRoot", "]"}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<First run the data-folder selection cell above.\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"strongSiteWXFFiles", "=", 
     RowBox[{"<|", 
      RowBox[{"\"\<All\>\"", "->", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<*.wxf\>\"", ",", "angleDataRoot", ",", "Infinity"}], 
          "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"FileNameTake", "[", "#", "]"}], "===", 
              "\"\<data.wxf\>\""}], "||", 
             RowBox[{"StringEndsQ", "[", 
              RowBox[{
               RowBox[{"FileNameTake", "[", "#", "]"}], ",", 
               "\"\<_data.wxf\>\""}], "]"}], "||", 
             RowBox[{"StringEndsQ", "[", 
              RowBox[{
               RowBox[{"FileNameTake", "[", "#", "]"}], ",", 
               "\"\<_plotdata.wxf\>\""}], "]"}]}], ")"}], "&&", 
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"FileNameTake", "[", "#", "]"}], "===", 
                "\"\<data.wxf\>\""}], ",", 
               RowBox[{"FileNameTake", "[", 
                RowBox[{"DirectoryName", "[", "#", "]"}], "]"}], ",", 
               RowBox[{"FileBaseName", "[", "#", "]"}]}], "]"}], ",", 
             "\"\<_site_strong_\>\""}], "]"}]}], "&"}]}], "]"}]}], "|>"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Strong-site files found: \>\"", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"strongSiteWXFFiles", "[", "\"\<All\>\"", "]"}], "]"}]}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0013792162321787`*^9, 
  4.001379216232709*^9}},ExpressionUUID->"3c4bfefd-e43a-43a9-91b3-\
cea9961a6094"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "StrongSite", " ", "statistics", " ", "without", " ", 
    "rerunning", " ", "any", " ", 
    RowBox[{"scans", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"strongSiteSpreadReport", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"files", ",", 
         RowBox[{"rows", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"issues", "=", 
          RowBox[{"{", "}"}]}], ",", "file", ",", "caseName", ",", "data", 
         ",", "raw", ",", "applyCut", ",", "selected", ",", "angles", ",", 
         "values", ",", "q", ",", "i", ",", "valid"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Same", " ", "selection", " ", "used", " ", "for", " ", "the", " ", 
         RowBox[{"WeakSite", "/", "WeakHopping"}], " ", 
         RowBox[{"comparison", "."}]}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"valid", "[", 
          RowBox[{"r_", ",", "cut_"}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "a", ",", "u"}], "}"}], ",", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"AssociationQ", "[", "r", "]"}]}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"TrueQ", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{
                 "r", ",", "\"\<NumericallyResolved\>\"", ",", "False"}], 
                 "]"}], "]"}]}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{
                "r", ",", "\"\<DegenerateLightMasses\>\"", ",", "False"}], 
                "]"}], "]"}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"m", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"r", ",", "\"\<LightMassesTeV\>\"", ",", 
               RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"a", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{"r", ",", "\"\<AnglesDegrees\>\"", ",", 
               RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"!", 
                RowBox[{"MatchQ", "[", 
                 RowBox[{"m", ",", 
                  RowBox[{"{", 
                   RowBox[{"_", ",", "_", ",", "_"}], "}"}]}], "]"}]}], "||", 
               
               RowBox[{"!", 
                RowBox[{"VectorQ", "[", 
                 RowBox[{"m", ",", "NumericQ"}], "]"}]}]}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"m", ",", 
                 RowBox[{
                  RowBox[{"TrueQ", "[", 
                   RowBox[{"#", ">", "0"}], "]"}], "&"}]}], "]"}]}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"!", 
                RowBox[{"MatchQ", "[", 
                 RowBox[{"a", ",", 
                  RowBox[{"{", 
                   RowBox[{"_", ",", "_", ",", "_"}], "}"}]}], "]"}]}], "||", 
               
               RowBox[{"!", 
                RowBox[{"VectorQ", "[", 
                 RowBox[{"a", ",", "NumericQ"}], "]"}]}]}], ",", 
              RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", "cut", "]"}], ",", 
              RowBox[{
               RowBox[{"u", "=", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"r", ",", "\"\<PMNS\>\"", ",", 
                  RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"MatrixQ", "[", 
                    RowBox[{"u", ",", "NumericQ"}], "]"}]}], "||", 
                  RowBox[{
                   RowBox[{"Dimensions", "[", "u", "]"}], "=!=", 
                   RowBox[{"{", 
                    RowBox[{"3", ",", "3"}], "}"}]}]}], ",", 
                 RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"!", 
                  RowBox[{"AllTrue", "[", 
                   RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{"Diagonal", "[", 
                    RowBox[{"u", ".", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], "]"}], 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"99", "/", "100"}], "<=", "#", "<=", 
                    RowBox[{"1", "+", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "30"}]}]}]}], "]"}], "&"}]}], "]"}]}], ",", 
                 RowBox[{"Return", "[", "False", "]"}]}], "]"}]}]}], "]"}], 
            ";", "\[IndentingNewLine]", "True"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Select", " ", "raw"}], "-", 
          RowBox[{"data", " ", "files", " ", "and", " ", "exclude", " ", 
           RowBox[{"scan_summary", ".", "wxf", "."}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"files", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Values", "[", "strongSiteWXFFiles", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"caseName", "=", 
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"FileNameTake", "[", "file", "]"}], "===", 
               "\"\<data.wxf\>\""}], ",", 
              RowBox[{"FileNameTake", "[", 
               RowBox[{"DirectoryName", "[", "file", "]"}], "]"}], ",", 
              RowBox[{"StringEndsQ", "[", 
               RowBox[{
                RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
                "\"\<_plotdata\>\""}], "]"}], ",", 
              RowBox[{"StringDrop", "[", 
               RowBox[{
                RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{"StringLength", "[", "\"\<_plotdata\>\"", "]"}]}]}], 
               "]"}], ",", "True", ",", 
              RowBox[{"StringDrop", "[", 
               RowBox[{
                RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
                RowBox[{"-", 
                 RowBox[{"StringLength", "[", "\"\<_data\>\"", "]"}]}]}], 
               "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"data", "=", 
            RowBox[{"LoadProductionData", "[", "file", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"AssociationQ", "[", "data", "]"}]}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"issues", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
                  RowBox[{
                  "\"\<Issue\>\"", "->", "\"\<Cannot read data file\>\""}]}], 
                 "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"raw", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"data", ",", "\"\<RawResults\>\"", ",", "$Failed"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"applyCut", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"data", ",", "\"\<ApplyRowCut\>\"", ",", "True"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"!", 
               RowBox[{"ListQ", "[", "raw", "]"}]}], "||", 
              RowBox[{"raw", "===", 
               RowBox[{"{", "}"}]}]}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"issues", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
                  RowBox[{
                  "\"\<Issue\>\"", "->", 
                   "\"\<Missing, empty or failed scan\>\""}], ",", 
                  RowBox[{"\"\<File\>\"", "->", "file"}]}], "|>"}]}], "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"selected", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"raw", ",", 
              RowBox[{
               RowBox[{"valid", "[", 
                RowBox[{"#", ",", "applyCut"}], "]"}], "&"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"selected", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"issues", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
                  RowBox[{
                  "\"\<Issue\>\"", "->", "\"\<No valid angle samples\>\""}]}],
                  "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"angles", "=", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"selected", ",", "\"\<AnglesDegrees\>\""}], "]"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"values", "=", 
               RowBox[{"angles", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              
              RowBox[{"q", "=", 
               RowBox[{"Quantile", "[", 
                RowBox[{"values", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"16", "/", "100"}], ",", 
                   RowBox[{"1", "/", "4"}], ",", 
                   RowBox[{"1", "/", "2"}], ",", 
                   RowBox[{"3", "/", "4"}], ",", 
                   RowBox[{"84", "/", "100"}]}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"rows", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Regime\>\"", "->", "\"\<StrongSite\>\""}], ",", 
                  RowBox[{"\"\<Case\>\"", "->", "caseName"}], ",", 
                  RowBox[{"\"\<Angle\>\"", "->", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    "\"\<theta12\>\"", ",", "\"\<theta13\>\"", ",", 
                    "\"\<theta23\>\""}], "}"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                  RowBox[{"\"\<Samples\>\"", "->", 
                   RowBox[{"Length", "[", "values", "]"}]}], ",", 
                  RowBox[{"\"\<TotalTrials\>\"", "->", 
                   RowBox[{"Length", "[", "raw", "]"}]}], ",", 
                  RowBox[{"\"\<RowCutApplied\>\"", "->", 
                   RowBox[{"TrueQ", "[", "applyCut", "]"}]}], ",", 
                  RowBox[{"\"\<MedianDegrees\>\"", "->", 
                   RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"q", "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "8"}], "]"}]}], ",", 
                  
                  RowBox[{"\"\<Q16Degrees\>\"", "->", 
                   RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"q", "[", 
