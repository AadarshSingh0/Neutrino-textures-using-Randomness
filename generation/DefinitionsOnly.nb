                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", "\"\<Case\>\"", "]"}], "===", "tag"}], 
                   "&"}]}], "]"}], ",", "\"\<Status\>\""}], "]"}], "]"}]}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"par", ",", "towerDiagnosticParameters"}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Export", " ", "the", " ", "complete", " ", "diagnostic", " ", 
          RowBox[{"records", ".", "Quantiles"}], " ", "and", " ", "table", 
          " ", "formatting", " ", "are", " ", "handled", " ", "in", " ", 
          RowBox[{"Analysis", ".", "nb", "."}]}], "*)"}], 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dataFile", ",", "saved"}], "}"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"StringQ", "[", 
               RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Please save the notebook. \>\"", ",", 
                "\"\<The generated records remain in \
towerDiagnosticSamples.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"dataFile", "=", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"NotebookDirectory", "[", "]"}], ",", 
               RowBox[{"\"\<TowerDiagnostics_\>\"", "<>", 
                RowBox[{"DateString", "[", 
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
                   ",", "\"\<_\>\"", ",", "\"\<Hour\>\"", ",", 
                   "\"\<Minute\>\"", ",", "\"\<Second\>\""}], "}"}], "]"}], 
                "<>", "\"\<.wxf\>\""}]}], "}"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"saved", "=", 
            RowBox[{"Export", "[", 
             RowBox[{"dataFile", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Configuration\>\"", "->", "cfg"}], ",", 
                RowBox[{
                "\"\<Parameters\>\"", "->", "towerDiagnosticParameters"}], 
                ",", 
                RowBox[{"\"\<Samples\>\"", "->", "towerDiagnosticSamples"}]}],
                "|>"}], ",", "\"\<WXF\>\""}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"saved", "===", "$Failed"}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Diagnostic export failed. \>\"", ",", 
                "\"\<The records remain in towerDiagnosticSamples.\>\""}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Diagnostic data saved to: \>\"", ",", "dataFile"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<DataFile\>\"", "->", "dataFile"}], ",", 
             RowBox[{"\"\<RecordCount\>\"", "->", 
              RowBox[{"Length", "[", "towerDiagnosticSamples", "]"}]}]}], 
            "|>"}]}]}], "]"}]}]}], "\n", "\[IndentingNewLine]", "]"}]}], 
