                    RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MatchQ", "[", 
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"r", ",", "\"\<LightMassesTeV\>\"", ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"_", ",", "_", ",", "_"}], "}"}]}], "]"}]}], "||", 
                    RowBox[{"!", 
                    RowBox[{"AllTrue", "[", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<LightMassesTeV\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"#", ">", "0"}], "]"}]}], "&"}]}], "]"}]}]}], ",", 
                    RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"MatchQ", "[", 
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"r", ",", "\"\<AnglesDegrees\>\"", ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"_", ",", "_", ",", "_"}], "}"}]}], "]"}]}], "||", 
                    RowBox[{"!", 
                    RowBox[{"VectorQ", "[", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<AnglesDegrees\>\"", "]"}], ",", 
                    "NumericQ"}], "]"}]}]}], ",", 
                    RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"TrueQ", "[", "applyCut", "]"}], ",", 
                    RowBox[{
                    RowBox[{"u", "=", 
                    RowBox[{"Lookup", "[", 
                    RowBox[{"r", ",", "\"\<PMNS\>\"", ",", 
