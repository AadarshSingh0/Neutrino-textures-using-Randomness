Cell[BoxData[
 RowBox[{
  RowBox[{"fig15Parameters", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"TSParameters", "[", 
      RowBox[{
      "\"\<StrongSite\>\"", ",", "\"\<Local\>\"", ",", "\"\<Dirac\>\"", ",", 
       "\"\<Boundary\>\""}], "]"}], ",", 
     RowBox[{"<|", 
      RowBox[{"(*", 
       RowBox[{"Graph", " ", "and", " ", "site", " ", "disorder"}], "*)"}], 
      RowBox[{
       RowBox[{"\"\<Sites\>\"", "->", "12"}], ",", 
       RowBox[{"\"\<SiteMean\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<SiteHalfWidth\>\"", "->", "10"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Uniform", "[", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "10"}], "]"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{"Hopping", " ", "and", " ", "distance", " ", "suppression"}], 
        "*)"}], 
       RowBox[{"\"\<HoppingMean\>\"", "->", 
        RowBox[{"1", "/", "10"}]}], ",", 
       RowBox[{"\"\<HoppingHalfWidth\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<DecayBase\>\"", "->", "5"}], ",", 
       RowBox[{"\"\<EdgeLaw\>\"", "->", "\"\<Uniform\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\"\<Numerator\>\"", ":", 
          RowBox[{
           RowBox[{"t", "/", 
            RowBox[{"b", "^", "distance"}]}], " ", 
           "\"\<NearestNeighbor\>\""}], ":", 
          RowBox[{"t", "/", 
           RowBox[{"b", "^", 
            RowBox[{"(", 
             RowBox[{"distance", "-", "1"}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"old", " ", "l"}], "=", 
          RowBox[{"t", "*", "b", " ", "convention"}]}]}], "*)"}], 
       RowBox[{"\"\<DistanceNormalization\>\"", "->", "\"\<Numerator\>\""}], 
       ",", 
       RowBox[{"(*", 
        RowBox[{"Hamiltonian", " ", "flavour", " ", 
         RowBox[{"matrix", ":", 
          RowBox[{
          "identity", " ", "for", " ", "boundary", " ", "mixing"}]}]}], 
        "*)"}], 
       RowBox[{"\"\<HamiltonianFlavor\>\"", "->", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Left", " ", "endpoint"}], "*)"}], 
       RowBox[{"\"\<ActiveCoupling\>\"", "->", 
        RowBox[{"173", "/", "1000"}]}], ",", 
       RowBox[{"\"\<ActiveFlavor\>\"", "->", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Right", " ", 
         RowBox[{"endpoint", ":", 
          RowBox[{
           RowBox[{"Eq", ".", 
            RowBox[{"(", "48", ")"}]}], " ", "Yukawa", " ", "texture"}]}]}], 
        "*)"}], 
       RowBox[{"\"\<DiracRightCoupling\>\"", "->", 
        RowBox[{"173", "/", "1000"}]}], ",", 
       RowBox[{"\"\<DiracRightFlavor\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"2", "/", "5"}], ",", 
            RowBox[{"3", "/", "5"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"3", "/", "10"}], ",", "1", ",", 
            RowBox[{"4", "/", "5"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"9", "/", "10"}], ",", 
            RowBox[{"3", "/", "10"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Numerical", " ", "settings"}], "*)"}], 
       RowBox[{"\"\<WorkingPrecision\>\"", "->", "80"}], ",", 
       RowBox[{"\"\<MassOrdering\>\"", "->", "\"\<Ascending\>\""}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "20261009"}]}], "|>"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.000597848715623*^9, 4.000597862127879*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"4e92cdbf-f95c-4e10-b0fe-fc928f352cee"],

