              RowBox[{"\"\<MinimumAbsHeavyEigenvalueTeV\>\"", "->", 
               RowBox[{"interval", "[", 
                RowBox[{"good", ",", "\"\<MinimumAbsHeavyEigenvalueTeV\>\""}],
                 "]"}]}], ",", 
              RowBox[{"\"\<SmallestHeavyGapInResolvedSamplesTeV\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"count", ">", "0"}], ",", 
                 RowBox[{"Min", "[", 
                  RowBox[{"Lookup", "[", 
                   RowBox[{
                   "good", ",", "\"\<MinimumAbsHeavyEigenvalueTeV\>\""}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"Missing", "[", "\"\<NoResolvedSamples\>\"", "]"}]}],
                 "]"}]}], ",", 
              RowBox[{"\"\<MaxNumericalCheckError\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"count", ">", "0"}], ",", 
                 RowBox[{"Max", "[", 
                  RowBox[{"Lookup", "[", 
                   RowBox[{"good", ",", "\"\<NumericalCheckError\>\""}], 
                   "]"}], "]"}], ",", 
                 RowBox[{"Missing", "[", "\"\<NoResolvedSamples\>\"", "]"}]}],
                 "]"}]}]}], "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Matched", " ", "subset", " ", "for", " ", "the", " ", "mass", " ", 
            RowBox[{"comparison", ".", "Flagged"}], " ", "samples", " ", 
            "still", " ", "contribute", " ", "to", " ", "tower", " ", 
            "diagnostics", " ", 
            RowBox[{"above", "."}]}], "*)"}], 
          RowBox[{"paired", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"good", ",", 
