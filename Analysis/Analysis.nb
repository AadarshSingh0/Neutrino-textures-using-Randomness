Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Locate", " ", "the", " ", "saved", " ", "weak"}], "-", 
    RowBox[{"site", " ", "and", " ", "weak"}], "-", 
    RowBox[{"hopping", " ", 
     RowBox[{"datasets", ".", "Select"}], " ", "either", " ", "the", " ", 
     "compact"}], "-", 
    RowBox[{
    "data", " ", "folder", " ", "or", " ", "the", " ", "parent", " ", 
     "folder", " ", "containing", " ", "the", " ", "original", " ", 
     "production", " ", 
     RowBox[{"folders", "."}]}]}], "*)"}], 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "root", ",", "files", ",", "caseName", ",", "entries", ",", "weakSite", 
      ",", "weakHopping", ",", "duplicates"}], "}"}], ",", 
    RowBox[{
     RowBox[{"root", "=", 
      RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"StringQ", "[", "root", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<No data folder selected.\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"files", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<*.wxf\>\"", ",", "root", ",", "Infinity"}], "]"}], ",", 
        
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"FileNameTake", "[", "#", "]"}], "===", 
           "\"\<data.wxf\>\""}], "||", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{
            RowBox[{"FileNameTake", "[", "#", "]"}], ",", 
            "\"\<_data.wxf\>\""}], "]"}], "||", 
          RowBox[{"StringEndsQ", "[", 
           RowBox[{
            RowBox[{"FileNameTake", "[", "#", "]"}], ",", 
            "\"\<_plotdata.wxf\>\""}], "]"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"caseName", "[", "file_", "]"}], ":=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FileNameTake", "[", "file", "]"}], "===", 
         "\"\<data.wxf\>\""}], ",", 
        RowBox[{"FileNameTake", "[", 
         RowBox[{"DirectoryName", "[", "file", "]"}], "]"}], ",", 
        RowBox[{"StringEndsQ", "[", 
         RowBox[{
          RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
          "\"\<_plotdata\>\""}], "]"}], ",", 
        RowBox[{"StringDrop", "[", 
         RowBox[{
          RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"StringLength", "[", "\"\<_plotdata\>\"", "]"}]}]}], "]"}],
         ",", "True", ",", 
        RowBox[{"StringDrop", "[", 
         RowBox[{
          RowBox[{"FileBaseName", "[", "file", "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"StringLength", "[", "\"\<_data\>\"", "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"entries", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Case\>\"", "->", 
            RowBox[{"caseName", "[", "#", "]"}]}], ",", 
           RowBox[{"\"\<DataFile\>\"", "->", "#"}]}], "|>"}], "&"}], ")"}], "/@",
        "files"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"weakSite", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"entries", ",", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Case\>\"", "]"}], ",", 
           "\"\<_site_weak_\>\""}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"weakHopping", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"entries", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Case\>\"", "]"}], ",", 
            "\"\<_hopp_weak_\>\""}], "]"}], "||", 
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Case\>\"", "]"}], ",", 
            "\"\<_hopping_weak_\>\""}], "]"}]}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"duplicates", "=", 
      RowBox[{"Keys", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Counts", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"StringReplace", "[", 
             RowBox[{
              RowBox[{"#", "[", "\"\<Case\>\"", "]"}], ",", 
              RowBox[{"\"\<_hopping_\>\"", "->", "\"\<_hopp_\>\""}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"Join", "[", 
            RowBox[{"weakSite", ",", "weakHopping"}], "]"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "1"}], "&"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"duplicates", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Duplicate cases found: \>\"", ",", "duplicates"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<Select one data version, original or compact.\>\"",
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "weakSite", "]"}], "=!=", "12"}], "||", 
        RowBox[{
         RowBox[{"Length", "[", "weakHopping", "]"}], "=!=", "12"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Expected 12 cases in each regime. Found weak site: \>\"", ",", 
          RowBox[{"Length", "[", "weakSite", "]"}], ",", 
          "\"\<, weak hopping: \>\"", ",", 
          RowBox[{"Length", "[", "weakHopping", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"angleDataRoot", "=", "root"}], ";", "\[IndentingNewLine]", 
     RowBox[{"weakSiteFinalSummary", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
        RowBox[{"\"\<Cases\>\"", "->", "weakSite"}]}], "|>"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"weakHoppingFinalSummary", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Folder\>\"", "->", "root"}], ",", 
        RowBox[{"\"\<Cases\>\"", "->", "weakHopping"}]}], "|>"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
     "Print", "[", 
      "\"\<Located 12 weak-site and 12 weak-hopping datasets.\>\"", "]"}], 
     ";"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.001379065238924*^9, 
  4.001379065239542*^9}},ExpressionUUID->"d4e55f1b-cffd-4d15-98ff-\
e9dc79cf8092"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Quantify", " ", "mixing"}], "-", 
     RowBox[{"angle", " ", "concentration", " ", "from", " ", "saved", " ", 
      RowBox[{"results", ".", "All"}], " ", "angular", " ", "quantities", " ",
       "are", " ", "in", " ", 
      RowBox[{"degrees", ".", 
       RowBox[{"Q16", "--"}]}], "Q84", " ", "describes", " ", "sample", " ", 
      "spread"}]}], ",", 
    RowBox[{"not", " ", "uncertainty", " ", "on", " ", "the", " ", 
     RowBox[{"median", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"angleSpreadReport", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"groups", ",", 
         RowBox[{"rows", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"issues", "=", 
          RowBox[{"{", "}"}]}], ",", "group", ",", "case", ",", "data", ",", 
         "raw", ",", "applyCut", ",", "selected", ",", "angles", ",", 
