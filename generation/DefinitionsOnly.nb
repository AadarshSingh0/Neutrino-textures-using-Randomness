  RowBox[{
   RowBox[{
    RowBox[{"towerDiagnosticConfig", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<SamplesPerCase\>\"", "->", "1000"}], ",", 
       RowBox[{"\"\<Sites\>\"", "->", "8"}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "2026101201"}], ",", 
       RowBox[{"\"\<WorkingPrecision\>\"", "->", "80"}], ",", 
       RowBox[{"\"\<PrecisionStep\>\"", "->", "40"}], ",", 
