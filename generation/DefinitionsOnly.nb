Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"FINAL", " ", "WEAK"}], "-", 
    RowBox[{
    "HOPPING", " ", "DATA", " ", "GENERATION", " ", "Loads", " ", "the", " ", 
     "released", " ", "exact", " ", 
     RowBox[{"parameters", ".", "No"}], " ", "benchmark", " ", "search", " ", 
     "or", " ", "plotting", " ", "is", " ", 
     RowBox[{"performed", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"weakHoppingFinalSummary", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"parameterFile", ",", "allParameters", ",", "benchmarks", ",", 
         RowBox[{"batchSize", "=", "100"}], ",", 
         RowBox[{"batchCount", "=", "100"}], ",", 
         RowBox[{"firstSeed", "=", "970001"}], ",", 
         RowBox[{"applyRowCut", "=", "True"}], ",", "folder", ",", 
         "caseNames", ",", "caseName", ",", "caseFolder", ",", "p", ",", 
         "seconds", ",", "raw", ",", "dataFile", ",", "settingsFile", ",", 
         "summaryFile", ",", "row", ",", 
         RowBox[{"summary", "=", 
          RowBox[{"{", "}"}]}], ",", "scanOK", ",", "j"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"StringQ", "[", 
            RowBox[{"NotebookDirectory", "[", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<Please save the notebook first.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"parameterFile", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ParentDirectory", "[", 
             RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", 
            "\"\<production_parameters\>\"", ",", 
            "\"\<Production_Parameters.wl\>\""}], "}"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"FileExistsQ", "[", "parameterFile", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Parameter file not found: \>\"", ",", "parameterFile"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allParameters", "=", 
         RowBox[{"Get", "[", "parameterFile", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "allParameters", "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<The parameter file did not return an Association.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"benchmarks", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"allParameters", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"AssociationQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"#", ",", "\"\<Preset\>\"", ",", "\"\<\>\""}], "]"}], 
              "===", "\"\<WeakHopping\>\""}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "benchmarks", "]"}], "=!=", "12"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Expected 12 weak-hopping benchmarks. Found: \>\"", ",", 
             RowBox[{"Length", "[", "benchmarks", "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"caseNames", "=", 
         RowBox[{"Keys", "[", "benchmarks", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"folder", "=", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], ",", 
             RowBox[{"\"\<WeakHopping_Final_\>\"", "<>", 
              RowBox[{"DateString", "[", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Year\>\"", ",", "\"\<Month\>\"", ",", "\"\<Day\>\"", 
                 ",", "\"\<_\>\"", ",", "\"\<Hour\>\"", ",", "\"\<Minute\>\"",
                  ",", "\"\<Second\>\""}], "}"}], "]"}]}]}], "}"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"settingsFile", "=", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"folder", ",", "\"\<production_settings.wxf\>\""}], 
             "}"}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Benchmarks\>\"", "->", "benchmarks"}], ",", 
             RowBox[{"\"\<ParameterSource\>\"", "->", "parameterFile"}], ",", 
             
             RowBox[{"\"\<BatchSize\>\"", "->", "batchSize"}], ",", 
             RowBox[{"\"\<BatchCount\>\"", "->", "batchCount"}], ",", 
             RowBox[{"\"\<FirstSeed\>\"", "->", "firstSeed"}], ",", 
             RowBox[{"\"\<LastSeed\>\"", "->", 
              RowBox[{"firstSeed", "+", 
               RowBox[{"batchSize", " ", "batchCount"}], "-", "1"}]}], ",", 
             RowBox[{"\"\<ApplyRowCut\>\"", "->", "applyRowCut"}]}], "|>"}], 
           ",", "\"\<WXF\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"settingsFile", "===", "$Failed"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<Could not save production settings. Stopping.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Saving weak-hopping data in: \>\"", ",", "folder"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"caseName", "=", 
            RowBox[{"caseNames", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "Preserve", " ", "the", " ", "exact", " ", "benchmark", " ", 
