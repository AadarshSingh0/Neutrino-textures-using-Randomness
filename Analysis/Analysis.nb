Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "ordinary", " ", "mean", " ", "participation", " ", "and", " ",
     "unnormalized", " ", 
    RowBox[{"P_end", ".", "Both"}], " ", "range", " ", "from", " ", "1", " ", 
    
    RowBox[{"(", 
     RowBox[{"one", "-", 
      RowBox[{"site", " ", "concentration"}]}], ")"}], " ", "to", " ", 
    RowBox[{"N", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"towerParticipationSummary", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"groups", ",", "interval"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"interval", "[", "values_List", "]"}], ":=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"values", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Missing", "[", "\"\<NoResolvedSamples\>\"", "]"}], ",", 
           RowBox[{"AssociationThread", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<Q16\>\"", ",", "\"\<Median\>\"", ",", "\"\<Q84\>\""}], 
              "}"}], ",", 
             RowBox[{"Quantile", "[", 
              RowBox[{"values", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"16", "/", "100"}], ",", 
                 RowBox[{"1", "/", "2"}], ",", 
                 RowBox[{"84", "/", "100"}]}], "}"}]}], "]"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"groups", "=", 
         RowBox[{"GroupBy", "[", 
          RowBox[{"towerDiagnosticSamples", ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Case\>\"", "]"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"case", ",", "records"}], "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"good", ",", "meanP", ",", "endP"}], "}"}], ",", 
              RowBox[{
               RowBox[{"good", "=", 
                RowBox[{"Select", "[", 
                 RowBox[{"records", ",", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", "\"\<Status\>\"", "]"}], "===", 
                    "\"\<OK\>\""}], "&"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Equal", " ", "weighting", " ", "of", " ", "every", " ", 
                 RowBox[{"eigenmode", "."}]}], "*)"}], 
               RowBox[{"meanP", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mean", "[", 
                   RowBox[{"#", "[", "\"\<Pk\>\"", "]"}], "]"}], "&"}], "/@", 
                 "good"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Restore", " ", "P_end", " ", "from", " ", "the", " ", 
                 "previously", " ", "stored", " ", 
                 RowBox[{"P_end", "/", 
                  RowBox[{"N", "."}]}]}], "*)"}], 
               RowBox[{"endP", "=", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Length", "[", 
                    RowBox[{"#", "[", "\"\<Pk\>\"", "]"}], "]"}], " ", 
                   RowBox[{"#", "[", "\"\<PEndOverN\>\"", "]"}]}], "&"}], "/@",
                  "good"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Case\>\"", "->", "case"}], ",", 
                 RowBox[{"\"\<Resolved\>\"", "->", 
                  RowBox[{"Length", "[", "good", "]"}]}], ",", 
                 RowBox[{"\"\<Total\>\"", "->", 
                  RowBox[{"Length", "[", "records", "]"}]}], ",", 
                 RowBox[{"\"\<MeanModeParticipation\>\"", "->", 
                  RowBox[{"interval", "[", "meanP", "]"}]}], ",", 
                 RowBox[{"\"\<EndpointWeightedParticipation\>\"", "->", 
                  RowBox[{"interval", "[", "endP", "]"}]}]}], "|>"}]}]}], 
             "]"}]}], "]"}], ",", "groups"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", 
     RowBox[{
      RowBox[{"median", "[", 
       RowBox[{"Q16", ",", "Q84"}], "]"}], "."}]}], "*)"}], "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fmt", ",", "rows"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"fmt", "[", "x_Association", "]"}], ":=", 
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"x", "[", "\"\<Median\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "3"}], "}"}]}], "]"}], ",", "\"\< [\>\"", ",", 
          
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"x", "[", "\"\<Q16\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "3"}], "}"}]}], "]"}], ",", "\"\<, \>\"", ",", 
          
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"x", "[", "\"\<Q84\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "3"}], "}"}]}], "]"}], ",", "\"\<]\>\""}], 
         "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fmt", "[", "x_", "]"}], ":=", "x"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rows", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", "\"\<Case\>\"", "]"}], ",", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", "\"\<Resolved\>\"", "]"}], ",", "\"\</\>\"", 
               ",", 
               RowBox[{"#", "[", "\"\<Total\>\"", "]"}]}], "}"}], "]"}], ",", 
            
            RowBox[{"fmt", "[", 
             RowBox[{"#", "[", "\"\<MeanModeParticipation\>\"", "]"}], "]"}], 
            ",", 
            RowBox[{"fmt", "[", 
             RowBox[{"#", "[", "\"\<EndpointWeightedParticipation\>\"", "]"}],
              "]"}]}], "}"}], "&"}], "/@", "towerParticipationSummary"}], 
        ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"rows", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Case\>\"", ",", "\"\<Resolved/total\>\"", ",", 
            "\"\<Mean mode participation: Pbar\>\"", ",", 
            "\"\<Endpoint-weighted participation: P_end\>\""}], "}"}]}], 
         "]"}], ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Alignment", "->", "Left"}]}], "]"}]}]}], "]"}]}]}]], "Input",\

