Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Load", " ", "original", " ", "or", " ", "compact", " ", "production", " ", 
    RowBox[{"data", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "LoadProductionData", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LoadProductionData", "[", "file_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "base", ",", "restored"}], "}"}], ",", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<WXF\>\""}], "]"}], ",", "$Failed"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "data", "]"}]}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"data", ",", "\"\<RawResults\>\"", ",", 
               RowBox[{"Missing", "[", "\"\<Absent\>\"", "]"}]}], "]"}], 
             "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Cannot read production data: \>\"", ",", "file"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Original", " ", "production", " ", "files", " ", "need", " ", "no", 
          " ", 
          RowBox[{"conversion", "."}]}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"data", ",", "\"\<Scope\>\"", ",", "\"\<\>\""}], "]"}], 
           "=!=", "\"\<CompactProductionData\>\""}], ",", 
          RowBox[{"Return", "[", "data", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"data", ",", "\"\<FormatVersion\>\"", ",", "0"}], "]"}], "=!=",
            "1"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Unsupported compact-data version: \>\"", ",", "file"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"base", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"data", ",", "\"\<Parameters\>\"", ",", 
           RowBox[{"Missing", "[", "\"\<Absent\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "base", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Compact file has no valid parameter association: \>\"", ",", 
             "file"}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"restored", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"record", ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"AssociationQ", "[", "record", "]"}], "&&", 
                RowBox[{"KeyExistsQ", "[", 
                 RowBox[{"record", ",", "\"\<ParameterOverrides\>\""}], "]"}],
                 "&&", 
                RowBox[{"KeyExistsQ", "[", 
                 RowBox[{"record", ",", "\"\<ParameterKeys\>\""}], "]"}]}], 
               ",", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"KeyDrop", "[", 
                  RowBox[{"record", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    "\"\<ParameterOverrides\>\"", ",", 
                    "\"\<ParameterKeys\>\""}], "}"}]}], "]"}], ",", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<Parameters\>\"", "->", 
                   RowBox[{"KeyTake", "[", 
                    RowBox[{
                    RowBox[{"Join", "[", 
                    RowBox[{"base", ",", 
                    RowBox[{
                    "record", "[", "\"\<ParameterOverrides\>\"", "]"}]}], 
                    "]"}], ",", 
                    RowBox[{"record", "[", "\"\<ParameterKeys\>\"", "]"}]}], 
                    "]"}]}], "|>"}]}], "]"}], ",", "record"}], "]"}]}], "]"}],
            ",", 
           RowBox[{"data", "[", "\"\<RawResults\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Join", "[", 
         RowBox[{"data", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<RawResults\>\"", "->", "restored"}], "|>"}]}], 
         "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
