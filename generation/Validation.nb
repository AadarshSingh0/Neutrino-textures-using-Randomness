      RowBox[{"p", ",", "n"}], "]"}], ":", 
     RowBox[{
     "Calculates", " ", "n", " ", "realizations", " ", "with", " ", 
      "consecutive", " ", "seeds"}]}], ";", 
    RowBox[{
     RowBox[{"add", " ", "\"\<Parallel\>\""}], "->", 
