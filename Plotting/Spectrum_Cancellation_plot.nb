Cell[CellGroupData[{
Cell[" L Nl Pet Site", "Title",
 CellChangeTimes->{{3.918703761611516*^9, 3.918703765667754*^9}, {
  3.9188558609472446`*^9, 
  3.918855862484294*^9}},ExpressionUUID->"ce49dc7c-927f-4972-971e-\
122d4bac4566"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generateG", "[", 
     RowBox[{"t_", ",", "W_", ",", "K_"}], "]"}], ":=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"W", "-", "t"}], ",", 
        RowBox[{"W", "+", "t"}]}], "}"}], ",", "K"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"ml", " ", 
    RowBox[{"matrix", ":", 
     RowBox[{
      RowBox[{"tridiagonal", " ", "with", " ", "random", " ", "onsite"}], "+", 
      RowBox[{"constant", " ", "hopping"}]}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeML", "[", 
     RowBox[{"t_", ",", "W_", ",", "K_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", ",", "Ox"}], "}"}], ",", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"generateG", "[", 
         RowBox[{"t", ",", "W", ",", "K"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Ox", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"K", ",", "K"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Ox", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"g", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Ox", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "i"}], "]"}], "]"}], "=", "t"}], 
          ";", 
          RowBox[{
           RowBox[{"Ox", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "=", "t"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"K", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"Ox", ",", 
         RowBox[{"Power", "[", 
          RowBox[{"10", ",", 
           RowBox[{"-", "20"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"mnl", " ", 
    RowBox[{"matrix", ":", 
     RowBox[{
      RowBox[{"exponential", " ", "decay", " ", "hopping"}], "+", 
      RowBox[{"random", " ", "onsite"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeMNL", "[", 
     RowBox[{"t_", ",", "W_", ",", "K_", ",", "l_", ",", "c_"}], "]"}], ":=", 
    
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", ",", "Ox"}], "}"}], ",", 
      RowBox[{
       RowBox[{"g", "=", 
        RowBox[{"generateG", "[", 
         RowBox[{"t", ",", "W", ",", "K"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Ox", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"l", "/", 
           RowBox[{"c", "^", 
            RowBox[{"Abs", "[", 
             RowBox[{"i", "-", "j"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "K"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "K"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Ox", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
          RowBox[{"g", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"Ox", ",", 
         RowBox[{"Power", "[", 
          RowBox[{"10", ",", 
           RowBox[{"-", "20"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"mpet", " ", 
    RowBox[{"matrix", ":", 
     RowBox[{
      RowBox[{"modified", " ", "Petersen", " ", "graph", " ", "adjacency"}], 
      "+", 
      RowBox[{"random", " ", "onsite"}], "+", 
      RowBox[{"exponential", " ", "decay"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makeMPET", "[", 
    RowBox[{"t_", ",", "W_", ",", "K_", ",", "l_", ",", "c_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", ",", "mat", ",", "p"}], "}"}], ",", 
     RowBox[{
      RowBox[{"g", "=", 
       RowBox[{"generateG", "[", 
        RowBox[{"t", ",", "W", ",", "K"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"PetersenGraph", "[", 
        RowBox[{
         RowBox[{"K", "/", "2"}], ",", 
         RowBox[{"K", "/", "4"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mat", "=", 
       RowBox[{"WeightedAdjacencyMatrix", "[", "p", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
         RowBox[{"g", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", "=!=", "j"}], ",", 
            RowBox[{
             RowBox[{"mat", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
             RowBox[{"l", "*", 
              RowBox[{
               RowBox[{"mat", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
               RowBox[{"c", "^", 
                RowBox[{"Abs", "[", 
                 RowBox[{"i", "-", "j"}], "]"}]}]}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "K"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "K"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Normal", "[", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"mat", ",", 
         RowBox[{"Power", "[", 
          RowBox[{"10", ",", 
           RowBox[{"-", "20"}]}], "]"}]}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f2eef77e-36c5-491a-87c8-b4f7c4cf7660"],

