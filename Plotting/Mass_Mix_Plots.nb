loadData[file_String]:=Module[{data,base,restored},data=Quiet[Check[Import[\
file,\"WXF\"],$Failed]];
If[!AssociationQ[data]||!ListQ[Lookup[data,\"RawResults\",Missing[\"Absent\"]]\
],Print[\"Cannot read production data: \",file];
Return[$Failed]];
(*Original production files need no \
conversion.*)If[Lookup[data,\"Scope\",\"\"]=!=\"CompactProductionData\",\
Return[data]];
If[Lookup[data,\"FormatVersion\",0]=!=1,Print[\"Unsupported compact-data \
version: \",file];
Return[$Failed]];
base=Lookup[data,\"Parameters\",Missing[\"Absent\"]];
If[!AssociationQ[base],Print[\"Compact file has no valid parameter \
association: \",file];
Return[$Failed]];
restored=Map[Function[record,If[AssociationQ[record]&&KeyExistsQ[record,\"\
ParameterOverrides\"]&&KeyExistsQ[record,\"ParameterKeys\"],Join[KeyDrop[\
record,{\"ParameterOverrides\",\"ParameterKeys\"}],<|\"Parameters\"->KeyTake[\
Join[base,record[\"ParameterOverrides\"]],record[\"ParameterKeys\"]]|>],\
record]],data[\"RawResults\"]];
Join[data,<|\"RawResults\"->restored|>]];

fail[tag_, text_, details_: <||>] :=
  Throw[Failure[tag, Join[<|\"MessageTemplate\" -> text|>, details]], \
\"PaperPlotFailure\"];

caseName[p_Association] := Module[{regime, channel},
  regime = Lookup[<|\"StrongSite\" -> \"site_strong\", \"WeakSite\" -> \
\"site_weak\",
    \"WeakHopping\" -> \"hopping_weak\"|>, Lookup[p, \"Preset\", \"\"], \
\"unsupported\"];
  channel = If[Lookup[p, \"Channel\", \"\"] === \"Hamiltonian\", \
\"hamiltonian\",
    If[Lookup[p, \"Nature\", \"\"] === \"Dirac\", \"yukawa\", \
\"majorana_coupling\"]];
  StringRiffle[{ToLowerCase[Lookup[p, \"Geometry\", \"unknown\"]], regime,
    channel, ToLowerCase[Lookup[p, \"Nature\", \"unknown\"]]}, \"_\"]
];

rowWeights[r_Association] := If[KeyExistsQ[r, \"PMNS\"],
  Re[Diagonal[r[\"PMNS\"].ConjugateTranspose[r[\"PMNS\"]]]],
  Lookup[r, \"ActiveRowWeights\", Missing[\"RowWeights\"]]];

sampleStatus[r_, cut_] := Module[{m, weights},
  If[!AssociationQ[r], Return[\"Calculation failure\"]];
  If[!TrueQ[Lookup[r, \"NumericallyResolved\", False]], Return[\"Numerically \
unresolved\"]];
  m = Lookup[r, \"LightMassesTeV\", {}];
  If[!VectorQ[m, NumericQ] || Length[m] != 3 || !AllTrue[m, TrueQ[# > 0] &],
    Return[\"Nonpositive or invalid mass\"]];
  If[TrueQ[cut],
    weights = rowWeights[r];
    If[!VectorQ[weights, NumericQ] || Length[weights] != 3,
      fail[\"MissingRowWeights\", \"A retained candidate has neither PMNS nor \
three ActiveRowWeights.\"]];
    (* Exactly the original notebook cut; no machine-precision relaxation. *)
    If[!AllTrue[weights, TrueQ[99/100 <= # <= 1 + 10^-30] &], Return[\"Row \
cut failed\"]]
  ];
  \"Kept\"
];

prepare[s_Association, file_String] := Module[
  {p, name, expected, different, raw, bs, cut, status, selected, angleRows,
   angles, angleCounts, batches, flags, medians, kept, j},
  p = Lookup[s, \"Parameters\", <||>]; name = caseName[p];
  If[!KeyExistsQ[manifest, name], fail[\"UnknownCase\", \"This is not one of \
the paper's 36 cases.\", <|\"File\" -> file|>]];
  expected = manifest[name];
  different = Select[Keys[expected[\"Parameters\"]],
    !SameQ[Lookup[p, #, Missing[\"Parameter\"]], expected[\"Parameters\"][#]] \
&];
  If[different =!= {}, fail[\"ParameterMismatch\", \"The saved parameters do \
not match the paper manifest.\",
    <|\"File\" -> file, \"Case\" -> name, \"DifferentKeys\" -> different|>]];
  raw = Lookup[s, \"RawResults\", {}]; bs = Lookup[s, \"BatchSize\", 0];
  cut = Lookup[s, \"ApplyRowCut\", Missing[\"ApplyRowCut\"]];
  If[!ListQ[raw] || raw === {}, fail[\"MissingSamples\", \"This file has no \
RawResults. Use original production data or the new compact export containing \
samples.\", <|\"File\" -> file|>]];
  If[bs =!= expected[\"BatchSize\"] || cut =!= expected[\"ApplyRowCut\"] ||
      Length[raw] =!= expected[\"RawCount\"] || !IntegerQ[bs] || bs <= 0 || \
Mod[Length[raw], bs] != 0,
    fail[\"BatchMismatch\", \"Batch size, sample count, or row-cut setting \
differs from the paper.\", <|\"File\" -> file|>]];
  status = sampleStatus[#, cut] & /@ raw;
  selected = Pick[raw, status, \"Kept\"];
  If[Length[selected] =!= expected[\"KeptCount\"],
    fail[\"SelectionMismatch\", \"Retained count differs from the paper. Use \
the original full-precision records; do not loosen the cut.\",
      <|\"File\" -> file, \"Expected\" -> expected[\"KeptCount\"], \"Counts\" \
-> Counts[status]|>]];
  angleRows = Select[selected, Function[r,
    !TrueQ[Lookup[r, \"DegenerateLightMasses\", True]] &&
    VectorQ[Lookup[r, \"AnglesDegrees\", {}], NumericQ] && \
Length[r[\"AnglesDegrees\"]] == 3]];
  If[angleRows === {}, fail[\"NoAngles\", \"No valid angle samples remain.\", \
<|\"File\" -> file|>]];
  angles = Transpose[Lookup[angleRows, \"AnglesDegrees\"]];
  angleCounts = (Last[HistogramList[#, {0, 90, 2}, \"Count\"]] &) /@ angles;
  If[angleCounts =!= expected[\"AngleBinCounts\"],
    fail[\"AngleBinsMismatch\", \"Angle-bin counts differ from the current \
paper figures.\", <|\"File\" -> file|>]];
  If[p[\"Preset\"] === \"WeakSite\" && !AllTrue[Flatten[angles], TrueQ[0 <= # \
<= 60] &],
    fail[\"AngleRange\", \"A weak-site sample lies outside the requested 0-60 \
degree range.\"]];
  (* Filter each ORIGINAL batch separately. Never repartition selected \
samples. *)
  batches = Partition[raw, bs]; flags = Partition[status, bs];
  medians = Table[
    kept = Pick[batches[[j]], flags[[j]], \"Kept\"];
    If[kept === {}, Nothing,
      <|\"Batch\" -> j, \"Retained\" -> Length[kept],
        \"MassesTeV\" -> (Median /@ Transpose[Lookup[kept, \
\"LightMassesTeV\"]])|>],
    {j, Length[batches]}];
  <|\"Case\" -> name, \"Parameters\" -> p, \"SourceFile\" -> file,
    \"Counts\" -> Counts[status], \"Angles\" -> angles,
    \"AngleBinCounts\" -> angleCounts,
    \"Masses\" -> Transpose[Lookup[selected, \"LightMassesTeV\"]],
    \"BatchMedians\" -> medians, \"BatchCount\" -> Length[batches]|>
];

font = \"DejaVu Sans\";
label[x_] := Style[x, Black, FontFamily -> font, FontSize -> 20];
common = {Frame -> True, Axes -> False, Background -> White,
  FrameStyle -> Directive[Black, AbsoluteThickness[1.15]],
  FrameTicksStyle -> Directive[Black, FontFamily -> font, FontSize -> 17],
  LabelStyle -> Directive[Black, FontFamily -> font, FontSize -> 17],
  BaseStyle -> {FontFamily -> font, FontColor -> Black},
  ImageSize -> 460, ImagePadding -> All, ImageMargins -> 10,
  AspectRatio -> 2/3, PlotRangePadding -> None};

legend[colors_, labels_, points_: False] := Inset[
  If[TrueQ[points],
    PointLegend[colors, labels, LegendLayout -> \"Row\", LegendMargins -> 0,
      LegendMarkers -> (Graphics[{#, Disk[]}, PlotRange -> 1.1, ImagePadding \
-> 0] & /@ colors),
      LegendMarkerSize -> 12,
      LabelStyle -> Directive[Black, FontFamily -> font, FontSize -> 17]],
    SwatchLegend[Directive[#, Opacity[1/2]] & /@ colors, labels,
      LegendLayout -> \"Row\", LegendMargins -> 0, LegendMarkerSize -> {10, \
13},
      LabelStyle -> Directive[Black, FontFamily -> font, FontSize -> 17]]],
  Scaled[{.97, .97}], {Right, Top}];

plots[d_Association] := Module[
  {p, name, geo, majorana, massColors, angleColors, aLabels, mLabels,
   channel, title, xmax, ymax, result, logs, points, vals, lo, hi, span, \
bounds},
  p = d[\"Parameters\"]; name = d[\"Case\"];
  geo = Lookup[<|\"Local\" -> \"Local\", \"NonLocal\" -> \"Non-local\", \
\"Petersen\" -> \"Petersen\"|>, p[\"Geometry\"]];
  majorana = p[\"Nature\"] === \"Majorana\";
  massColors = If[majorana,
    {RGBColor[204/255, 92/255, 92/255], RGBColor[230/255, 153/255, 0], \
RGBColor[143/255, 89/255, 184/255]},
    {RGBColor[.560181, .691569, .194885], RGBColor[.368417, .506779, \
.709798], RGBColor[.978580, .678934, .157834]}];
  angleColors = If[majorana, massColors[[{3, 2, 1}]], massColors[[{2, 3, 1}]]];
  aLabels = Subscript[Style[FromCharacterCode[952], Italic], #] & /@ {12, 13, \
23};
  mLabels = Subscript[Style[\"m\", Italic], #] & /@ {1, 2, 3};
  channel = If[p[\"Channel\"] === \"Hamiltonian\", \"Hamiltonian mixing\",
    If[majorana, \"Majorana coupling mixing\", \"Yukawa mixing\"]];
  title = If[channel === \"Majorana coupling mixing\", geo <> \"\\n\" <> \
channel, geo <> \" - \" <> channel];
  xmax = If[p[\"Preset\"] === \"WeakSite\", 60, 90];
  ymax = 1.35 Max[Flatten[d[\"AngleBinCounts\"]]];
  If[name === \"petersen_site_weak_yukawa_dirac\", ymax = 10000];
  result = <|\"angles\" -> Histogram[d[\"Angles\"], {0, 90, 2}, \"Count\",
    ChartLayout -> \"Overlapped\", ChartStyle -> (Directive[#, Opacity[1/2]] \
& /@ angleColors),
    FrameLabel -> {label[\"Mixing angle (degrees)\"], label[\"Counts\"]},
    PlotLabel -> label[title], PlotRange -> {{0, xmax}, {0, ymax}},
    FrameTicks -> {{Automatic, None}, {Range[0, xmax, If[xmax == 60, 20, \
30]], None}},
    Epilog -> {legend[angleColors, aLabels]}, Evaluate[Sequence @@ \
common]]|>;
  If[KeyExistsQ[manifest[name][\"FileNames\"], \"mass_histogram\"],
    logs = Log[10, d[\"Masses\"]]; bounds = \
manifest[name][\"MassHistogramRange\"];
    ymax = 1.35 Max[Flatten[(Last[HistogramList[#, {1/4}, \"Count\"]] &) /@ \
logs]];
    AssociateTo[result, \"mass_histogram\" -> Histogram[logs, {1/4}, \"Count\",
      ChartLayout -> \"Overlapped\", ChartStyle -> (Directive[#, \
Opacity[1/2]] & /@ massColors),
      FrameLabel -> {label[Row[{Subscript[\"log\", 10], \"(\", Style[\"m\", \
Italic], \"/TeV)\"}]], label[\"Counts\"]},
      PlotLabel -> label[geo <> \" - mass histogram\"], PlotRange -> {bounds, \
{0, ymax}},
      Epilog -> {legend[massColors, mLabels]}, Evaluate[Sequence @@ common]]]
  ];
  If[KeyExistsQ[manifest[name][\"FileNames\"], \"mass_median\"],
    points = Table[({#[\"Batch\"], Log[10, #[\"MassesTeV\"][[i]]]} & /@ \
d[\"BatchMedians\"]), {i, 3}];
    vals = Flatten[points[[All, All, 2]]]; lo = Min[vals]; hi = Max[vals]; \
span = Max[hi - lo, .001];
    AssociateTo[result, \"mass_median\" -> ListPlot[points,
      PlotStyle -> (Directive[#, AbsolutePointSize[3.2]] & /@ massColors),
      FrameLabel -> {label[\"Batch index\"],
        label[Row[{Subscript[\"log\", 10], \"(median(\", Style[\"m\", \
Italic], \")/TeV)\"}]]},
      PlotLabel -> label[geo <> \" - mass medians\"],
      PlotRange -> {{0, d[\"BatchCount\"] + 1}, {lo - .06 span, hi + .38 \
span}},
      FrameTicks -> {{Automatic, None}, {Range[0, d[\"BatchCount\"], 25], \
None}},
      Epilog -> {legend[massColors, mLabels, True]}, Evaluate[Sequence @@ \
common]]]
  ];
  result
];

PaperPlotExport[input_, output_String] := Catch[Module[
  {root, files, saved, p, name, raw, prepared = <||>, skipped = {}, errors = \
{},
   data, missing, out, expectedNames, actualNames, graphics, path, exported = \
{}, report, kind},
  root = input;
  files = Which[
    ListQ[root] && AllTrue[root, StringQ], DeleteDuplicates[root],
    StringQ[root] && DirectoryQ[root], Select[FileNames[\"*.wxf\", root, \
Infinity],
      FileNameTake[#] === \"data.wxf\" || StringEndsQ[#, \"_data.wxf\"] || \
StringEndsQ[#, \"_plotdata.wxf\"] &],
    True, fail[\"InputPath\", \"Supply a data folder or an explicit list of \
WXF file paths.\"]];
  If[files === {}, fail[\"NoFiles\", \"No data WXF files were specified.\"]];
  missing = Select[files, !FileExistsQ[#] &];
  If[missing =!= {}, fail[\"MissingFiles\", \"The following configured data \
files were not found.\",
    <|\"Files\" -> missing|>]];
  Do[
    Print[\"Reading \", file];
    saved = loadData[file];
    If[!AssociationQ[saved], AppendTo[errors, <|\"File\" -> file, \"Problem\" \
-> \"Import failed\"|>]; Continue[]];
    p = Lookup[saved, \"Parameters\", <||>];
    If[!AssociationQ[p], AppendTo[skipped, file]; Continue[]];
    name = caseName[p]; raw = Lookup[saved, \"RawResults\", {}];
    If[!KeyExistsQ[manifest, name] || !ListQ[raw] || raw === {}, \
AppendTo[skipped, file]; Continue[]];
    If[KeyExistsQ[prepared, name],
      AppendTo[errors, <|\"Case\" -> name, \"Problem\" -> \"Duplicate \
populated case; select only one production file per case.\",
        \"Files\" -> {prepared[name][\"SourceFile\"], file}|>]; Continue[]];
    data = Catch[prepare[saved, file], \"PaperPlotFailure\"];
    If[FailureQ[data], AppendTo[errors, data], AssociateTo[prepared, name -> \
data]];
    Clear[saved, raw];
    , {file, files}];
  missing = Complement[Keys[manifest], Keys[prepared]];
  If[errors =!= {} || missing =!= {},
    fail[\"PreflightFailed\", \"No PDFs exported. Resolve the missing, \
mismatched or duplicate cases listed below.\",
      <|\"MissingCases\" -> missing, \"Errors\" -> errors, \"SkippedFiles\" \
-> skipped|>]];
  Print[\"Preview:\"];
  Print[plots[prepared[\"local_hopping_weak_majorana_coupling_majorana\"]][\"\
angles\"]];
  out = output;
  If[!StringQ[out], fail[\"OutputPath\", \"The output path must be a \
directory string.\"]];
  If[!DirectoryQ[out], CreateDirectory[out, CreateIntermediateDirectories -> \
True]];
  Do[
    graphics = plots[prepared[name]];
    Do[
      path = FileNameJoin[{out, manifest[name][\"FileNames\"][kind]}];
      If[Check[Export[path, graphics[kind], \"PDF\"], $Failed] === $Failed ||
          !FileExistsQ[path] || FileByteCount[path] == 0,
        fail[\"ExportFailed\", \"A PDF export failed.\", <|\"File\" -> path, \
\"AlreadyExported\" -> exported|>]];
      AppendTo[exported, path]; Print[\"Saved \", FileNameTake[path]];
      , {kind, Keys[manifest[name][\"FileNames\"]]}];
    , {name, Sort[Keys[manifest]]}];
  expectedNames = Sort[Flatten[Values[#[\"FileNames\"]] & /@ \
Values[manifest]]];
  actualNames = Sort[FileNameTake /@ exported];
  If[Length[exported] != 60 || actualNames =!= expectedNames,
    fail[\"FilenameMismatch\", \"The exported filename set does not match the \
paper.\"]];
  report = <|\"PDFCount\" -> Length[exported], \"Folder\" -> out,
    \"WolframVersion\" -> $Version, \"ExportedFiles\" -> exported,
    \"SourceFiles\" -> AssociationMap[prepared[#][\"SourceFile\"] &, \
Keys[prepared]],
    \"SelectionCounts\" -> AssociationMap[prepared[#][\"Counts\"] &, \
Keys[prepared]],
    \"AllParametersAndAngleBinsMatched\" -> True|>;
  If[Check[Export[FileNameJoin[{DirectoryName[out], \
\"plot_export_report.wxf\"}], report, \"WXF\"], $Failed] === $Failed,
    fail[\"ReportExportFailed\", \"PDFs were exported but saving their report \
failed.\", <|\"Folder\" -> out|>]];
  Export[FileNameJoin[{DirectoryName[out], \"expected_filenames.txt\"}],
    StringRiffle[expectedNames, \"\\n\"], \"Text\"];
  Print[\"Finished: all 60 paper filenames exported to \", out];
  report
], \"PaperPlotFailure\"];


(* Select either a compact-data folder or the parent of the four
   original production-data folders. No simulations are run. *)
If[!StringQ[NotebookDirectory[]],
  Print[\"Save this notebook in your plotting folder before running it.\"];
  Return[$Failed]
];
Print[\"Select the data folder containing all 36 production cases.\"];
dataRoot = SystemDialogInput[\"Directory\"];
If[!StringQ[dataRoot], Print[\"No data folder selected.\"]; Return[$Canceled]];
outputFolder = FileNameJoin[{NotebookDirectory[],
  \"PaperPlots_\" <> DateString[{\"Year\", \"Month\", \"Day\", \"_\", \
\"Hour\", \"Minute\", \"Second\"}] <>
    \"_\" <> StringTake[CreateUUID[], 8], \"figures\"}];
runResult = PaperPlotExport[dataRoot, outputFolder];
If[FailureQ[runResult],
  Print[\"Export stopped. Details:\"]; Print[runResult],
  Print[\"DONE: 60 PDFs with the exact paper filenames.\"];
  Print[\"Output folder: \", outputFolder]
];
runResult
]
\
\>", "Code",
 Evaluatable->False,ExpressionUUID->"ad9b576a-9231-4fb9-a65e-f19cb106e88c"]
}, Closed]]
}, Open  ]]
},
WindowSize->{978.75, 632.25},
WindowMargins->{{209.25, Automatic}, {40.5, Automatic}},
WindowTitle->"Mass_Mix_Plots",
TaggingRules-><|
 "PaperPlotSource" -> 
  "Module[{manifest, fail, caseName, rowWeights, sampleStatus, prepare, font, \
label, common, legend, plots, PaperPlotExport, loadData, dataRoot, \
outputFolder, runResult},\n(* The verified paper manifest is inserted here by \
the source packager. *)\nmanifest = <|\n  \
\"local_hopping_weak_hamiltonian_dirac\" -> <|\"Parameters\" -> <|\"Nature\" \
-> \"Dirac\", \"Geometry\" -> \"Local\", \"Preset\" -> \"WeakHopping\", \
