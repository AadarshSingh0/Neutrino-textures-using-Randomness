               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Folder\>\"", "->", "folder"}], ",", 
                 RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}], 
               "]"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "caseNames", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Folder\>\"", "->", "folder"}], ",", 
          RowBox[{"\"\<Cases\>\"", "->", "summary"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
