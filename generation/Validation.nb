  RowBox[{"(*", 
   RowBox[{
    RowBox[{"TSGenerateBlocks", "[", "p", "]"}], ":", 
    RowBox[{
    "Generates", " ", "six", " ", "random", " ", "graph", " ", "mass", " ", 
     "blocks", " ", "using", " ", "the", " ", "specified", " ", "parameters", 
