Cell[CellGroupData[{

Cell["Export compact data for release", "Subsection",
 CellChangeTimes->{{4.000851970761154*^9, 4.000851975608075*^9}, 
   4.001378380472974*^9},ExpressionUUID->"0c41c2ec-9947-4651-bed6-\
19252996f473"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "EXPORT", " ", "COMPACT", " ", "PRODUCTION", " ", "DATA", " ", "Original", 
    " ", "files", " ", "are", " ", "never", " ", 
    RowBox[{"modified", ".", "No"}], " ", "samples", " ", "are", " ", 
    "filtered", " ", "and", " ", "no", " ", "numbers", " ", "are", " ", 
    RowBox[{"rounded", "."}]}], "*)"}], 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "root", ",", "files", ",", "caseName", ",", "names", ",", "duplicates", 
      ",", "out", ",", 
      RowBox[{"report", "=", 
       RowBox[{"{", "}"}]}], ",", "source", ",", "raw", ",", "parameters", 
      ",", "first", ",", "small", ",", "compact", ",", "destination", ",", 
      "saved", ",", "archive", ",", "removeKeys", ",", "compactRecord", ",", 
      "name", ",", "file"}], "}"}], ",", 
    RowBox[{
     RowBox[{"root", "=", 
      RowBox[{"SystemDialogInput", "[", "\"\<Directory\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"StringQ", "[", "root", "]"}]}], ",", 
       RowBox[{"Return", "[", "$Canceled", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Preserve", " ", "the", " ", "original", " ", "case", " ", 
       RowBox[{"names", "."}]}], "*)"}], 
     RowBox[{
      RowBox[{"caseName", "[", "f_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FileNameTake", "[", "f", "]"}], "===", "\"\<data.wxf\>\""}],
         ",", 
        RowBox[{"FileNameTake", "[", 
         RowBox[{"DirectoryName", "[", "f", "]"}], "]"}], ",", 
        RowBox[{"StringDrop", "[", 
         RowBox[{
          RowBox[{"FileBaseName", "[", "f", "]"}], ",", 
          RowBox[{"-", "5"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"files", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<*.wxf\>\"", ",", "root", ",", "Infinity"}], "]"}], ",", 
        
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"FileNameTake", "[", "#", "]"}], "===", 
             "\"\<data.wxf\>\""}], "||", 
            RowBox[{"StringEndsQ", "[", 
             RowBox[{
              RowBox[{"FileBaseName", "[", "#", "]"}], ",", "\"\<_data\>\""}],
              "]"}]}], ")"}], "&&", 
          RowBox[{"StringMatchQ", "[", 
           RowBox[{
            RowBox[{"caseName", "[", "#", "]"}], ",", 
            RowBox[{"RegularExpression", "[", 
             RowBox[{
             "\"\<^(local|nonlocal|petersen)_\>\"", "<>", 
              "\"\<(site|hopp|hopping)_(strong|weak)_\>\"", "<>", 
              "\"\<(yukawa|hamiltonian|majorana_coupling)_\>\"", "<>", 
              "\"\<(dirac|majorana)$\>\""}], "]"}]}], "]"}]}], "&"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"files", "===", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<No production data files found in this folder.\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"names", "=", 
      RowBox[{"caseName", "/@", "files"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"duplicates", "=", 
      RowBox[{"Keys", "[", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Counts", "[", "names", "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "1"}], "&"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"duplicates", "=!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Multiple source files found for these cases: \>\"", ",", 
          "duplicates"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<Select a folder containing one production version per \
case.\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"out", "=", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"DirectoryName", "[", "root", "]"}], ",", 
          RowBox[{"\"\<CompactPlotData_\>\"", "<>", 
           RowBox[{"StringTake", "[", 
            RowBox[{
             RowBox[{"CreateUUID", "[", "]"}], ",", "8"}], "]"}]}]}], "}"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Retain", " ", "all", " ", "other", " ", "result", " ", "fields"}], 
       ",", 
       RowBox[{"including", " ", "PMNS"}], ",", 
       RowBox[{"light", " ", "masses"}], ",", 
       RowBox[{"angles", " ", "and", " ", "numerical", " ", 
        RowBox[{"diagnostics", "."}]}]}], "*)"}], 
     RowBox[{"removeKeys", "=", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Parameters\>\"", ",", "\"\<AllMassesTeV\>\"", ",", 
        "\"\<TowerBlocks\>\"", ",", "\"\<FinalMatrix\>\"", ",", 
        "\"\<LightVectors\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"compactRecord", "[", 
       RowBox[{"r_", ",", "base_Association"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"record", ",", "originalParameters", ",", "overrides"}], 
         "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Preserve", " ", "failures", " ", "and", " ", "unusual", " ", 
          "records", " ", 
          RowBox[{"unchanged", "."}]}], "*)"}], 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "r", "]"}]}], ",", 
           RowBox[{"Return", "[", "r", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"r", ",", "\"\<Parameters\>\""}], "]"}]}], ",", 
           RowBox[{"Return", "[", "r", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"originalParameters", "=", 
          RowBox[{"r", "[", "\"\<Parameters\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "originalParameters", "]"}]}], ",", 
           RowBox[{"Return", "[", "r", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"record", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"r", ",", "removeKeys"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Preserve", " ", "sample"}], "-", 
            RowBox[{"specific", " ", "parameters"}]}], ",", 
           RowBox[{"especially", " ", "the", " ", 
            RowBox[{"seed", "."}]}]}], "*)"}], 
         RowBox[{"overrides", "=", 
          RowBox[{"Association", "[", 
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"key", ",", "value"}], "}"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"KeyExistsQ", "[", 
                    RowBox[{"base", ",", "key"}], "]"}]}], "||", 
                  RowBox[{"!", 
                   RowBox[{"SameQ", "[", 
                    RowBox[{
                    RowBox[{"base", "[", "key", "]"}], ",", "value"}], 
                    "]"}]}]}], ",", 
                 RowBox[{"key", "->", "value"}], ",", "Nothing"}], "]"}]}], 
              "]"}], ",", "originalParameters"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"record", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<ParameterOverrides\>\"", "->", "overrides"}], ",", 
             RowBox[{"\"\<ParameterKeys\>\"", "->", 
              RowBox[{"Keys", "[", "originalParameters", "]"}]}]}], "}"}]}], 
          "]"}], ";", "\[IndentingNewLine]", "record"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Found \>\"", ",", 
       RowBox[{"Length", "[", "files", "]"}], ",", 
       "\"\< production cases.\>\""}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Saving compact data in: \>\"", ",", "out"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"name", "=", 
         RowBox[{"caseName", "[", "file", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Processing: \>\"", ",", "name"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"source", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Import", "[", 
             RowBox[{"file", ",", "\"\<WXF\>\""}], "]"}], ",", "$Failed"}], 
           "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"AssociationQ", "[", "source", "]"}]}], "||", 
           RowBox[{"!", 
            RowBox[{"ListQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"source", ",", "\"\<RawResults\>\"", ",", 
               RowBox[{"Missing", "[", "\"\<Absent\>\"", "]"}]}], "]"}], 
             "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Invalid production-data structure: \>\"", ",", "file"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"raw", "=", 
         RowBox[{"source", "[", "\"\<RawResults\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"parameters", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"source", ",", "\"\<Parameters\>\"", ",", 
           RowBox[{"Missing", "[", "\"\<NotStored\>\"", "]"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "parameters", "]"}]}], ",", 
          RowBox[{
           RowBox[{"first", "=", 
            RowBox[{"SelectFirst", "[", 
             RowBox[{"raw", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"AssociationQ", "[", "#", "]"}], "&&", 
                RowBox[{"AssociationQ", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"#", ",", "\"\<Parameters\>\"", ",", "None"}], 
                  "]"}], "]"}]}], "&"}], ",", 
              RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"AssociationQ", "[", "first", "]"}], ",", 
             RowBox[{"parameters", "=", 
              RowBox[{"first", "[", "\"\<Parameters\>\"", "]"}]}]}], 
            "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"AssociationQ", "[", "parameters", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Could not recover parameters for: \>\"", ",", "name"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"small", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"compactRecord", "[", 
            RowBox[{"#", ",", "parameters"}], "]"}], "&"}], "/@", "raw"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "small", "]"}], "=!=", 
           RowBox[{"Length", "[", "raw", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Record-count mismatch for: \>\"", ",", "name"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"compact", "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"KeyDrop", "[", 
            RowBox[{"source", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<RawResults\>\"", ",", "\"\<Parameters\>\""}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<FormatVersion\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<Scope\>\"", "->", "\"\<CompactProductionData\>\""}],
              ",", 
             RowBox[{"\"\<Case\>\"", "->", "name"}], ",", 
             RowBox[{"\"\<Parameters\>\"", "->", "parameters"}], ",", 
             RowBox[{"\"\<SourceFile\>\"", "->", "file"}], ",", 
             RowBox[{"\"\<OriginalRecordCount\>\"", "->", 
              RowBox[{"Length", "[", "raw", "]"}]}], ",", 
             RowBox[{"\"\<RemovedResultFields\>\"", "->", 
              RowBox[{"DeleteCases", "[", 
               RowBox[{"removeKeys", ",", "\"\<Parameters\>\""}], "]"}]}], 
             ",", 
             RowBox[{"\"\<RawResults\>\"", "->", "small"}]}], "|>"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"destination", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"out", ",", 
            RowBox[{"name", "<>", "\"\<_plotdata.wxf\>\""}]}], "}"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"saved", "=", 
         RowBox[{"Export", "[", 
          RowBox[{"destination", ",", "compact", ",", "\"\<WXF\>\""}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"saved", "===", "$Failed"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Export failed for: \>\"", ",", "name"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"report", ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", 
            RowBox[{"Length", "[", "raw", "]"}], ",", 
            RowBox[{"FileByteCount", "[", "file", "]"}], ",", 
            RowBox[{"FileByteCount", "[", "destination", "]"}]}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"source", ",", "raw", ",", "small", ",", "compact"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"file", ",", "files"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"saved", "=", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"out", ",", "\"\<export_report.csv\>\""}], "}"}], "]"}], 
        ",", 
        RowBox[{"Prepend", "[", 
         RowBox[{"report", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Case\>\"", ",", "\"\<Records\>\"", ",", 
            "\"\<OriginalBytes\>\"", ",", "\"\<CompactBytes\>\""}], "}"}]}], 
         "]"}], ",", "\"\<CSV\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"saved", "===", "$Failed"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Data files were saved, but the export report failed.\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"archive", "=", 
      RowBox[{"CreateArchive", "[", 
       RowBox[{"out", ",", 
        RowBox[{"out", "<>", "\"\<.zip\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"Grid", "[", 
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"report", ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Case\>\"", ",", "\"\<Records\>\"", ",", 
            "\"\<Original bytes\>\"", ",", "\"\<Compact bytes\>\""}], "}"}]}],
          "]"}], ",", 
        RowBox[{"Frame", "->", "All"}]}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Compact data folder: \>\"", ",", "out"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"archive", "===", "$Failed"}], ",", 
       RowBox[{
       "Print", "[", 
        "\"\<ZIP creation failed. The compact files remain in the \
folder.\>\"", "]"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ZIP file: \>\"", ",", "archive"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Folder\>\"", "->", "out"}], ",", 
       RowBox[{"\"\<Archive\>\"", "->", "archive"}], ",", 
       RowBox[{"\"\<Report\>\"", "->", "report"}]}], "|>"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.00137847821317*^9, 4.001378478213788*^9}, 
   4.001378583289339*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"09d703fa-2249-48dc-bc13-122a40f44fdc"]
