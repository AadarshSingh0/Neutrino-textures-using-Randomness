            RowBox[{"cfg", ",", 
             RowBox[{"_", "?", "MachineNumberQ"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<Use exact inputs such as 1/5, not machine decimals such as \
0.2.\>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
