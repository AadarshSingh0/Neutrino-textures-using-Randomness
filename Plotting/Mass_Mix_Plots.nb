loadData[file_String]:=Module[{data,base,restored},data=Quiet[Check[Import[\
file,\"WXF\"],$Failed]];\n\
If[!AssociationQ[data]||!ListQ[Lookup[data,\"RawResults\",Missing[\"Absent\"]]\
],Print[\"Cannot read production data: \",file];\nReturn[$Failed]];\n\
(*Original production files need no \
conversion.*)If[Lookup[data,\"Scope\",\"\"]=!=\"CompactProductionData\",\
Return[data]];\nIf[Lookup[data,\"FormatVersion\",0]=!=1,Print[\"Unsupported \
compact-data version: \",file];\nReturn[$Failed]];\n\
base=Lookup[data,\"Parameters\",Missing[\"Absent\"]];\n\
If[!AssociationQ[base],Print[\"Compact file has no valid parameter \
association: \",file];\nReturn[$Failed]];\n\
restored=Map[Function[record,If[AssociationQ[record]&&KeyExistsQ[record,\"\
ParameterOverrides\"]&&KeyExistsQ[record,\"ParameterKeys\"],Join[KeyDrop[\
record,{\"ParameterOverrides\",\"ParameterKeys\"}],<|\"Parameters\"->KeyTake[\
Join[base,record[\"ParameterOverrides\"]],record[\"ParameterKeys\"]]|>],\
record]],data[\"RawResults\"]];\nJoin[data,<|\"RawResults\"->restored|>]];\n\n\
fail[tag_, text_, details_: <||>] :=\n  Throw[Failure[tag, \
Join[<|\"MessageTemplate\" -> text|>, details]], \"PaperPlotFailure\"];\n\n\
caseName[p_Association] := Module[{regime, channel},\n  regime = \
Lookup[<|\"StrongSite\" -> \"site_strong\", \"WeakSite\" -> \"site_weak\",\n  \
  \"WeakHopping\" -> \"hopping_weak\"|>, Lookup[p, \"Preset\", \"\"], \
\"unsupported\"];\n  channel = If[Lookup[p, \"Channel\", \"\"] === \
\"Hamiltonian\", \"hamiltonian\",\n    If[Lookup[p, \"Nature\", \"\"] === \
\"Dirac\", \"yukawa\", \"majorana_coupling\"]];\n  \
StringRiffle[{ToLowerCase[Lookup[p, \"Geometry\", \"unknown\"]], regime,\n    \
channel, ToLowerCase[Lookup[p, \"Nature\", \"unknown\"]]}, \"_\"]\n];\n\n\
rowWeights[r_Association] := If[KeyExistsQ[r, \"PMNS\"],\n  \
Re[Diagonal[r[\"PMNS\"].ConjugateTranspose[r[\"PMNS\"]]]],\n  Lookup[r, \
\"ActiveRowWeights\", Missing[\"RowWeights\"]]];\n\nsampleStatus[r_, cut_] := \
Module[{m, weights},\n  If[!AssociationQ[r], Return[\"Calculation \
failure\"]];\n  If[!TrueQ[Lookup[r, \"NumericallyResolved\", False]], Return[\
\"Numerically unresolved\"]];\n  m = Lookup[r, \"LightMassesTeV\", {}];\n  \
If[!VectorQ[m, NumericQ] || Length[m] != 3 || !AllTrue[m, TrueQ[# > 0] &],\n  \
  Return[\"Nonpositive or invalid mass\"]];\n  If[TrueQ[cut],\n    weights = \
rowWeights[r];\n    If[!VectorQ[weights, NumericQ] || Length[weights] != 3,\n \
     fail[\"MissingRowWeights\", \"A retained candidate has neither PMNS nor \
three ActiveRowWeights.\"]];\n    (* Exactly the original notebook cut; no \
machine-precision relaxation. *)\n    If[!AllTrue[weights, TrueQ[99/100 <= # \
<= 1 + 10^-30] &], Return[\"Row cut failed\"]]\n  ];\n  \"Kept\"\n];\n\n\
prepare[s_Association, file_String] := Module[\n  {p, name, expected, \
different, raw, bs, cut, status, selected, angleRows,\n   angles, \
angleCounts, batches, flags, medians, kept, j},\n  p = Lookup[s, \"Parameters\
\", <||>]; name = caseName[p];\n  If[!KeyExistsQ[manifest, name], \
fail[\"UnknownCase\", \"This is not one of the paper's 36 cases.\", \
<|\"File\" -> file|>]];\n  expected = manifest[name];\n  different = \
Select[Keys[expected[\"Parameters\"]],\n    !SameQ[Lookup[p, #, \
Missing[\"Parameter\"]], expected[\"Parameters\"][#]] &];\n  If[different =!= \
{}, fail[\"ParameterMismatch\", \"The saved parameters do not match the paper \
manifest.\",\n    <|\"File\" -> file, \"Case\" -> name, \"DifferentKeys\" -> \
different|>]];\n  raw = Lookup[s, \"RawResults\", {}]; bs = Lookup[s, \
\"BatchSize\", 0];\n  cut = Lookup[s, \"ApplyRowCut\", \
Missing[\"ApplyRowCut\"]];\n  If[!ListQ[raw] || raw === {}, \
fail[\"MissingSamples\", \"This file has no RawResults. Use original \
production data or the new compact export containing samples.\", <|\"File\" \
-> file|>]];\n  If[bs =!= expected[\"BatchSize\"] || cut =!= \
expected[\"ApplyRowCut\"] ||\n      Length[raw] =!= expected[\"RawCount\"] || \
!IntegerQ[bs] || bs <= 0 || Mod[Length[raw], bs] != 0,\n    \
fail[\"BatchMismatch\", \"Batch size, sample count, or row-cut setting \
differs from the paper.\", <|\"File\" -> file|>]];\n  status = \
sampleStatus[#, cut] & /@ raw;\n  selected = Pick[raw, status, \"Kept\"];\n  \
If[Length[selected] =!= expected[\"KeptCount\"],\n    \
fail[\"SelectionMismatch\", \"Retained count differs from the paper. Use the \
original full-precision records; do not loosen the cut.\",\n      <|\"File\" \
-> file, \"Expected\" -> expected[\"KeptCount\"], \"Counts\" -> \
Counts[status]|>]];\n  angleRows = Select[selected, Function[r,\n    \
!TrueQ[Lookup[r, \"DegenerateLightMasses\", True]] &&\n    VectorQ[Lookup[r, \
\"AnglesDegrees\", {}], NumericQ] && Length[r[\"AnglesDegrees\"]] == 3]];\n  \
If[angleRows === {}, fail[\"NoAngles\", \"No valid angle samples remain.\", \
<|\"File\" -> file|>]];\n  angles = Transpose[Lookup[angleRows, \
\"AnglesDegrees\"]];\n  angleCounts = (Last[HistogramList[#, {0, 90, 2}, \
\"Count\"]] &) /@ angles;\n  If[angleCounts =!= expected[\"AngleBinCounts\"],\
\n    fail[\"AngleBinsMismatch\", \"Angle-bin counts differ from the current \
paper figures.\", <|\"File\" -> file|>]];\n  If[p[\"Preset\"] === \
\"WeakSite\" && !AllTrue[Flatten[angles], TrueQ[0 <= # <= 60] &],\n    \
fail[\"AngleRange\", \"A weak-site sample lies outside the requested 0-60 \
degree range.\"]];\n  (* Filter each ORIGINAL batch separately. Never \
repartition selected samples. *)\n  batches = Partition[raw, bs]; flags = \
Partition[status, bs];\n  medians = Table[\n    kept = Pick[batches[[j]], \
flags[[j]], \"Kept\"];\n    If[kept === {}, Nothing,\n      <|\"Batch\" -> j, \
\"Retained\" -> Length[kept],\n        \"MassesTeV\" -> (Median /@ \
Transpose[Lookup[kept, \"LightMassesTeV\"]])|>],\n    {j, Length[batches]}];\n\
  <|\"Case\" -> name, \"Parameters\" -> p, \"SourceFile\" -> file,\n    \
\"Counts\" -> Counts[status], \"Angles\" -> angles,\n    \"AngleBinCounts\" \
-> angleCounts,\n    \"Masses\" -> Transpose[Lookup[selected, \
\"LightMassesTeV\"]],\n    \"BatchMedians\" -> medians, \"BatchCount\" -> \
Length[batches]|>\n];\n\nfont = \"DejaVu Sans\";\nlabel[x_] := Style[x, \
Black, FontFamily -> font, FontSize -> 20];\ncommon = {Frame -> True, Axes -> \
False, Background -> White,\n  FrameStyle -> Directive[Black, \
AbsoluteThickness[1.15]],\n  FrameTicksStyle -> Directive[Black, FontFamily \
-> font, FontSize -> 17],\n  LabelStyle -> Directive[Black, FontFamily -> \
font, FontSize -> 17],\n  BaseStyle -> {FontFamily -> font, FontColor -> \
Black},\n  ImageSize -> 460, ImagePadding -> All, ImageMargins -> 10,\n  \
AspectRatio -> 2/3, PlotRangePadding -> None};\n\nlegend[colors_, labels_, \
points_: False] := Inset[\n  If[TrueQ[points],\n    PointLegend[colors, \
labels, LegendLayout -> \"Row\", LegendMargins -> 0,\n      LegendMarkers -> \
(Graphics[{#, Disk[]}, PlotRange -> 1.1, ImagePadding -> 0] & /@ colors),\n   \
   LegendMarkerSize -> 12,\n      LabelStyle -> Directive[Black, FontFamily \
-> font, FontSize -> 17]],\n    SwatchLegend[Directive[#, Opacity[1/2]] & /@ \
colors, labels,\n      LegendLayout -> \"Row\", LegendMargins -> 0, \
LegendMarkerSize -> {10, 13},\n      LabelStyle -> Directive[Black, \
FontFamily -> font, FontSize -> 17]]],\n  Scaled[{.97, .97}], {Right, Top}];\n\
\nplots[d_Association] := Module[\n  {p, name, geo, majorana, massColors, \
angleColors, aLabels, mLabels,\n   channel, title, xmax, ymax, result, logs, \
points, vals, lo, hi, span, bounds},\n  p = d[\"Parameters\"]; name = \
d[\"Case\"];\n  geo = Lookup[<|\"Local\" -> \"Local\", \"NonLocal\" -> \
\"Non-local\", \"Petersen\" -> \"Petersen\"|>, p[\"Geometry\"]];\n  majorana \
= p[\"Nature\"] === \"Majorana\";\n  massColors = If[majorana,\n    \
{RGBColor[204/255, 92/255, 92/255], RGBColor[230/255, 153/255, 0], \
RGBColor[143/255, 89/255, 184/255]},\n    {RGBColor[.560181, .691569, \
.194885], RGBColor[.368417, .506779, .709798], RGBColor[.978580, .678934, \
.157834]}];\n  angleColors = If[majorana, massColors[[{3, 2, 1}]], \
massColors[[{2, 3, 1}]]];\n  aLabels = \
Subscript[Style[FromCharacterCode[952], Italic], #] & /@ {12, 13, 23};\n  \
mLabels = Subscript[Style[\"m\", Italic], #] & /@ {1, 2, 3};\n  channel = \
If[p[\"Channel\"] === \"Hamiltonian\", \"Hamiltonian mixing\",\n    \
If[majorana, \"Majorana coupling mixing\", \"Yukawa mixing\"]];\n  title = \
If[channel === \"Majorana coupling mixing\", geo <> \"\\n\" <> channel, geo \
<> \" - \" <> channel];\n  xmax = If[p[\"Preset\"] === \"WeakSite\", 60, 90];\
\n  ymax = 1.35 Max[Flatten[d[\"AngleBinCounts\"]]];\n  If[name === \
\"petersen_site_weak_yukawa_dirac\", ymax = 10000];\n  result = <|\"angles\" \
-> Histogram[d[\"Angles\"], {0, 90, 2}, \"Count\",\n    ChartLayout -> \
\"Overlapped\", ChartStyle -> (Directive[#, Opacity[1/2]] & /@ angleColors),\n\
    FrameLabel -> {label[\"Mixing angle (degrees)\"], label[\"Counts\"]},\n   \
 PlotLabel -> label[title], PlotRange -> {{0, xmax}, {0, ymax}},\n    \
FrameTicks -> {{Automatic, None}, {Range[0, xmax, If[xmax == 60, 20, 30]], \
None}},\n    Epilog -> {legend[angleColors, aLabels]}, Evaluate[Sequence @@ \
common]]|>;\n  If[KeyExistsQ[manifest[name][\"FileNames\"], \
\"mass_histogram\"],\n    logs = Log[10, d[\"Masses\"]]; bounds = \
manifest[name][\"MassHistogramRange\"];\n    ymax = 1.35 \
Max[Flatten[(Last[HistogramList[#, {1/4}, \"Count\"]] &) /@ logs]];\n    \
AssociateTo[result, \"mass_histogram\" -> Histogram[logs, {1/4}, \"Count\",\n \
     ChartLayout -> \"Overlapped\", ChartStyle -> (Directive[#, Opacity[1/2]] \
& /@ massColors),\n      FrameLabel -> {label[Row[{Subscript[\"log\", 10], \
\"(\", Style[\"m\", Italic], \"/TeV)\"}]], label[\"Counts\"]},\n      \
PlotLabel -> label[geo <> \" - mass histogram\"], PlotRange -> {bounds, {0, \
ymax}},\n      Epilog -> {legend[massColors, mLabels]}, Evaluate[Sequence @@ \
common]]]\n  ];\n  If[KeyExistsQ[manifest[name][\"FileNames\"], \"mass_median\
\"],\n    points = Table[({#[\"Batch\"], Log[10, #[\"MassesTeV\"][[i]]]} & /@ \
d[\"BatchMedians\"]), {i, 3}];\n    vals = Flatten[points[[All, All, 2]]]; lo \
= Min[vals]; hi = Max[vals]; span = Max[hi - lo, .001];\n    \
AssociateTo[result, \"mass_median\" -> ListPlot[points,\n      PlotStyle -> \
(Directive[#, AbsolutePointSize[3.2]] & /@ massColors),\n      FrameLabel -> \
{label[\"Batch index\"],\n        label[Row[{Subscript[\"log\", 10], \
\"(median(\", Style[\"m\", Italic], \")/TeV)\"}]]},\n      PlotLabel -> \
label[geo <> \" - mass medians\"],\n      PlotRange -> {{0, d[\"BatchCount\"] \
+ 1}, {lo - .06 span, hi + .38 span}},\n      FrameTicks -> {{Automatic, \
None}, {Range[0, d[\"BatchCount\"], 25], None}},\n      Epilog -> \
{legend[massColors, mLabels, True]}, Evaluate[Sequence @@ common]]]\n  ];\n  \
result\n];\n\nPaperPlotExport[input_, output_String] := Catch[Module[\n  \
{root, files, saved, p, name, raw, prepared = <||>, skipped = {}, errors = \
{},\n   data, missing, out, expectedNames, actualNames, graphics, path, \
exported = {}, report, kind},\n  root = input;\n  files = Which[\n    \
ListQ[root] && AllTrue[root, StringQ], DeleteDuplicates[root],\n    \
StringQ[root] && DirectoryQ[root], Select[FileNames[\"*.wxf\", root, \
Infinity],\n      FileNameTake[#] === \"data.wxf\" || StringEndsQ[#, \
\"_data.wxf\"] || StringEndsQ[#, \"_plotdata.wxf\"] &],\n    True, \
fail[\"InputPath\", \"Supply a data folder or an explicit list of WXF file \
paths.\"]];\n  If[files === {}, fail[\"NoFiles\", \"No data WXF files were \
specified.\"]];\n  missing = Select[files, !FileExistsQ[#] &];\n  If[missing \
=!= {}, fail[\"MissingFiles\", \"The following configured data files were not \
found.\",\n    <|\"Files\" -> missing|>]];\n  Do[\n    Print[\"Reading \", \
file];\n    saved = loadData[file];\n    If[!AssociationQ[saved], \
AppendTo[errors, <|\"File\" -> file, \"Problem\" -> \"Import failed\"|>]; \
Continue[]];\n    p = Lookup[saved, \"Parameters\", <||>];\n    \
If[!AssociationQ[p], AppendTo[skipped, file]; Continue[]];\n    name = \
caseName[p]; raw = Lookup[saved, \"RawResults\", {}];\n    \
If[!KeyExistsQ[manifest, name] || !ListQ[raw] || raw === {}, \
AppendTo[skipped, file]; Continue[]];\n    If[KeyExistsQ[prepared, name],\n   \
   AppendTo[errors, <|\"Case\" -> name, \"Problem\" -> \"Duplicate populated \
case; select only one production file per case.\",\n        \"Files\" -> \
{prepared[name][\"SourceFile\"], file}|>]; Continue[]];\n    data = \
Catch[prepare[saved, file], \"PaperPlotFailure\"];\n    If[FailureQ[data], \
AppendTo[errors, data], AssociateTo[prepared, name -> data]];\n    \
Clear[saved, raw];\n    , {file, files}];\n  missing = \
Complement[Keys[manifest], Keys[prepared]];\n  If[errors =!= {} || missing \
=!= {},\n    fail[\"PreflightFailed\", \"No PDFs exported. Resolve the \
missing, mismatched or duplicate cases listed below.\",\n      \
<|\"MissingCases\" -> missing, \"Errors\" -> errors, \"SkippedFiles\" -> \
skipped|>]];\n  Print[\"Preview:\"];\n  \
Print[plots[prepared[\"local_hopping_weak_majorana_coupling_majorana\"]][\"\
angles\"]];\n  out = output;\n  If[!StringQ[out], fail[\"OutputPath\", \"The \
output path must be a directory string.\"]];\n  If[!DirectoryQ[out], \
CreateDirectory[out, CreateIntermediateDirectories -> True]];\n  Do[\n    \
graphics = plots[prepared[name]];\n    Do[\n      path = FileNameJoin[{out, \
manifest[name][\"FileNames\"][kind]}];\n      If[Check[Export[path, \
graphics[kind], \"PDF\"], $Failed] === $Failed ||\n          \
!FileExistsQ[path] || FileByteCount[path] == 0,\n        \
fail[\"ExportFailed\", \"A PDF export failed.\", <|\"File\" -> path, \
\"AlreadyExported\" -> exported|>]];\n      AppendTo[exported, path]; \
Print[\"Saved \", FileNameTake[path]];\n      , {kind, \
Keys[manifest[name][\"FileNames\"]]}];\n    , {name, Sort[Keys[manifest]]}];\n\
  expectedNames = Sort[Flatten[Values[#[\"FileNames\"]] & /@ \
Values[manifest]]];\n  actualNames = Sort[FileNameTake /@ exported];\n  \
If[Length[exported] != 60 || actualNames =!= expectedNames,\n    \
fail[\"FilenameMismatch\", \"The exported filename set does not match the \
paper.\"]];\n  report = <|\"PDFCount\" -> Length[exported], \"Folder\" -> \
out,\n    \"WolframVersion\" -> $Version, \"ExportedFiles\" -> exported,\n    \
\"SourceFiles\" -> AssociationMap[prepared[#][\"SourceFile\"] &, \
Keys[prepared]],\n    \"SelectionCounts\" -> \
AssociationMap[prepared[#][\"Counts\"] &, Keys[prepared]],\n    \
\"AllParametersAndAngleBinsMatched\" -> True|>;\n  \
If[Check[Export[FileNameJoin[{DirectoryName[out], \
\"plot_export_report.wxf\"}], report, \"WXF\"], $Failed] === $Failed,\n    \
fail[\"ReportExportFailed\", \"PDFs were exported but saving their report \
failed.\", <|\"Folder\" -> out|>]];\n  \
Export[FileNameJoin[{DirectoryName[out], \"expected_filenames.txt\"}],\n    \
StringRiffle[expectedNames, \"\\n\"], \"Text\"];\n  Print[\"Finished: all 60 \
paper filenames exported to \", out];\n  report\n], \"PaperPlotFailure\"];\n\n\
\n(* Select either a compact-data folder or the parent of the four\n   \
original production-data folders. No simulations are run. *)\n\
If[!StringQ[NotebookDirectory[]],\n  Print[\"Save this notebook in your \
plotting folder before running it.\"];\n  Return[$Failed]\n];\nPrint[\"Select \
the data folder containing all 36 production cases.\"];\ndataRoot = \
SystemDialogInput[\"Directory\"];\nIf[!StringQ[dataRoot], Print[\"No data \
folder selected.\"]; Return[$Canceled]];\noutputFolder = \
FileNameJoin[{NotebookDirectory[],\n  \"PaperPlots_\" <> \
DateString[{\"Year\", \"Month\", \"Day\", \"_\", \"Hour\", \"Minute\", \
\"Second\"}] <>\n    \"_\" <> StringTake[CreateUUID[], 8], \"figures\"}];\n\
runResult = PaperPlotExport[dataRoot, outputFolder];\nIf[FailureQ[runResult],\
\n  Print[\"Export stopped. Details:\"]; Print[runResult],\n  Print[\"DONE: \
60 PDFs with the exact paper filenames.\"];\n  Print[\"Output folder: \", \
outputFolder]\n];\nrunResult\n]\n"|>,
FrontEndVersion->"13.2 for Linux x86 (64-bit) (December 7, 2022)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"56923a03-c917-41ca-bdd8-a0108f66767e"
]
(* End of Notebook Content *)

