       RowBox[{"\"\<DistanceNormalization\>\"", "->", "\"\<Numerator\>\""}], 
       ",", 
       RowBox[{"\"\<EdgeLaw\>\"", "->", "\"\<Uniform\>\""}], ",", 
       RowBox[{"(*", 
