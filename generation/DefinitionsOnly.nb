Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Optional", " ", "inspection", " ", "of", " ", "masses", " ", "from", " ",
      "the", " ", "angle"}], "-", 
    RowBox[{"search", " ", 
     RowBox[{"results", ".", "Requires"}], " ", "overnightFitSummary", " ", 
     "and", " ", "the", " ", "search", " ", "helper", " ", 
     RowBox[{"definitions", ".", "Not"}], " ", "needed", " ", "when", " ", 
     "generating", " ", "data", " ", "from", " ", "frozen", " ", 
     RowBox[{"benchmarks", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"massOverview", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "saved", ",", "raw", ",", "kept", ",", "masses", ",", 
           "splittings"}], "}"}], ",", 
         RowBox[{
          RowBox[{"saved", "=", 
           RowBox[{"Import", "[", 
            RowBox[{
             RowBox[{"entry", "[", "\"\<DataFile\>\"", "]"}], ",", 
             "\"\<WXF\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AssociationQ", "[", "saved", "]"}]}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Case\>\"", "->", 
                RowBox[{"entry", "[", "\"\<Case\>\"", "]"}]}], ",", 
               RowBox[{
               "\"\<Status\>\"", "->", "\"\<Could not load data\>\""}]}], 
              "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"raw", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"saved", ",", "\"\<RawResults\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"kept", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"ListQ", "[", "raw", "]"}], ",", 
             RowBox[{"Select", "[", 
              RowBox[{"raw", ",", "NFValid"}], "]"}], ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"kept", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Return", "[", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Case\>\"", "->", 
                RowBox[{"entry", "[", "\"\<Case\>\"", "]"}]}], ",", 
               RowBox[{"\"\<Status\>\"", "->", "\"\<No valid samples\>\""}]}],
               "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Convert", " ", "TeV", " ", "to", " ", "eV", " ", "before", " ", 
            "computing", " ", 
            RowBox[{"splittings", "."}]}], "*)"}], 
          RowBox[{"masses", "=", 
           RowBox[{
            RowBox[{"10", "^", "12"}], " ", 
            RowBox[{"Lookup", "[", 
             RowBox[{"kept", ",", "\"\<LightMassesTeV\>\""}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"splittings", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], "^", "2"}], "-", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "^", "2"}]}]}], "}"}], 
              "&"}], ")"}], "/@", "masses"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Case\>\"", "->", 
             RowBox[{"entry", "[", "\"\<Case\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Median masses (eV)\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Median", "/@", 
                RowBox[{"Transpose", "[", "masses", "]"}]}], ",", "5"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<Median sum (eV)\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Median", "[", 
                RowBox[{"Total", "/@", "masses"}], "]"}], ",", "5"}], "]"}]}],
             ",", 
            RowBox[{"\"\<Median {Delta21, Delta31} (eV^2)\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Median", "/@", 
                RowBox[{"Transpose", "[", "splittings", "]"}]}], ",", "5"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<Median Delta21/Delta31\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Median", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "/", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "&"}], ")"}], "/@", 
                 "splittings"}], "]"}], ",", "5"}], "]"}]}]}], "|>"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"entry", ",", 
         RowBox[{"overnightFitSummary", "[", "\"\<Cases\>\"", "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"Dataset", "[", "massOverview", "]"}]}]}]], "Input",
